---
/**
 * ============================================================================
 * COMPONENTESXD — 08. Mechanical Hard-Offset Push Button (ASTRO 5)
 * Archivo: components/buttons/variants/industrial-offset-trigger/IndustrialOffsetTrigger.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '08. Mechanical Hard-Offset Push Button',
  badge = 'TACTILE PUSH',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-buttons-industrial-offset-trigger" data-theme={interfaceTheme} data-variant="industrial-offset-trigger">
  <header class="cxd-buttons-industrial-offset-trigger__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-buttons-industrial-offset-trigger__body">
    <p>Recorrido físico vertical al presionar con sombra sólida que colapsa en el estado :active.</p>
    <slot />
  </div>
</section>
