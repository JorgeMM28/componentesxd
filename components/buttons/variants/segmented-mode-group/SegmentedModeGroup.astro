---
/**
 * ============================================================================
 * COMPONENTESXD — 07. Segmented Action Bar with Active Pill (ASTRO 5)
 * Archivo: components/buttons/variants/segmented-mode-group/SegmentedModeGroup.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '07. Segmented Action Bar with Active Pill',
  badge = 'BUTTON GROUP',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-buttons-segmented-mode-group" data-theme={interfaceTheme} data-variant="segmented-mode-group">
  <header class="cxd-buttons-segmented-mode-group__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-buttons-segmented-mode-group__body">
    <p>Barra de herramientas unificada por bordes de 1px para alternar vistas (Tabla / Tarjetas / Grafo / JSON).</p>
    <slot />
  </div>
</section>
