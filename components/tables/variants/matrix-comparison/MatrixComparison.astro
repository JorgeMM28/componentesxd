---
/**
 * ============================================================================
 * COMPONENTESXD — 04. Sticky Spec & Feature Comparison Matrix (ASTRO 5)
 * Archivo: components/tables/variants/matrix-comparison/MatrixComparison.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '04. Sticky Spec & Feature Comparison Matrix',
  badge = 'SPEC MATRIX',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-tables-matrix-comparison" data-theme={interfaceTheme} data-variant="matrix-comparison">
  <header class="cxd-tables-matrix-comparison__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-tables-matrix-comparison__body">
    <p>Tabla comparativa con primera columna fija, indicadores vectoriales SVG de soporte, límites técnicos y cabeceras congeladas.</p>
    <slot />
  </div>
</section>
