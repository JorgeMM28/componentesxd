---
/**
 * ============================================================================
 * COMPONENTESXD — 05. Inline Editable Data Sheet (ASTRO 5)
 * Archivo: components/tables/variants/inline-editable-sheet/InlineEditableSheet.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '05. Inline Editable Data Sheet',
  badge = 'SPREADSHEET UI',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-tables-inline-editable-sheet" data-theme={interfaceTheme} data-variant="inline-editable-sheet">
  <header class="cxd-tables-inline-editable-sheet__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-tables-inline-editable-sheet__body">
    <p>Celdas editables directamente al hacer clic con resaltado de celda activa, validación instantánea y navegación por teclado.</p>
    <slot />
  </div>
</section>
