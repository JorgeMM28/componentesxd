---
/**
 * ============================================================================
 * COMPONENTESXD — SPOTLIGHT BENTO CARD (ASTRO)
 * Archivo: components/cards/astro/SpotlightCard.astro
 * ============================================================================
 */
import '../css-scss/cards.css';

interface Props {
  tag: string;
  title: string;
  metric: string;
  delta?: string;
  description: string;
}

const { tag, title, metric, delta = '+18.4%', description } = Astro.props;
---

<article class="cxd-spotlight-card">
  <div class="cxd-card-header">
    <span class="cxd-card-tag">{tag}</span>
    <span class="cxd-card-delta">{delta}</span>
  </div>
  <h4>{title}</h4>
  <div class="cxd-card-metric">{metric}</div>
  <p class="cxd-card-desc">{description}</p>
</article>

