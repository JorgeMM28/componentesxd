---
/**
 * ============================================================================
 * COMPONENTESXD — 06. Traefik v3 Automatic TLS + Reverse Proxy (ASTRO 5)
 * Archivo: components/docker/variants/traefik-reverse-proxy/TraefikReverseProxy.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '06. Traefik v3 Automatic TLS + Reverse Proxy',
  badge = 'REVERSE PROXY',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-docker-traefik-reverse-proxy" data-theme={interfaceTheme} data-variant="traefik-reverse-proxy">
  <header class="cxd-docker-traefik-reverse-proxy__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-docker-traefik-reverse-proxy__body">
    <p>Configuración lista para enrutar múltiples contenedores locales con certificados y balanceo automático.</p>
    <slot />
  </div>
</section>
