---
/**
 * ============================================================================
 * COMPONENTESXD — 03. React / Vue / Svelte / Angular SPA + Nginx (ASTRO 5)
 * Archivo: components/docker/variants/spa-nginx-brotli/SpaNginxBrotli.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '03. React / Vue / Svelte / Angular SPA + Nginx',
  badge = 'NGINX ALPINE',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-docker-spa-nginx-brotli" data-theme={interfaceTheme} data-variant="spa-nginx-brotli">
  <header class="cxd-docker-spa-nginx-brotli__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-docker-spa-nginx-brotli__body">
    <p>Compila estáticos en etapa builder y sirve con Nginx configurado con fallback SPA y cabeceras de caché.</p>
    <slot />
  </div>
</section>
