---
/**
 * ============================================================================
 * COMPONENTESXD — 06. Full Pagination + Page Size Selector Bar (ASTRO 5)
 * Archivo: components/navigation/variants/pagination-matrix-bar/PaginationMatrixBar.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '06. Full Pagination + Page Size Selector Bar',
  badge = 'PAGINATION',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-navigation-pagination-matrix-bar" data-theme={interfaceTheme} data-variant="pagination-matrix-bar">
  <header class="cxd-navigation-pagination-matrix-bar__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-navigation-pagination-matrix-bar__body">
    <p>Control de paginación con salto directo a página, selector desplegable de filas por vista y rango actual.</p>
    <slot />
  </div>
</section>
