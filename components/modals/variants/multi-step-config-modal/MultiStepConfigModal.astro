---
/**
 * ============================================================================
 * COMPONENTESXD — 04. Stepped Configuration Wizard Modal (ASTRO 5)
 * Archivo: components/modals/variants/multi-step-config-modal/MultiStepConfigModal.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '04. Stepped Configuration Wizard Modal',
  badge = 'WIZARD MODAL',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-modals-multi-step-config-modal" data-theme={interfaceTheme} data-variant="multi-step-config-modal">
  <header class="cxd-modals-multi-step-config-modal__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-modals-multi-step-config-modal__body">
    <p>Ventana modal dividida en pasos con indicador de progreso superior y pie de navegación persistente.</p>
    <slot />
  </div>
</section>
