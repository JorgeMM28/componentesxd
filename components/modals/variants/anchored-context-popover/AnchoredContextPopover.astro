---
/**
 * ============================================================================
 * COMPONENTESXD — 05. Anchored Context Menu & Quick Popover (ASTRO 5)
 * Archivo: components/modals/variants/anchored-context-popover/AnchoredContextPopover.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '05. Anchored Context Menu & Quick Popover',
  badge = 'CONTEXT MENU',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-modals-anchored-context-popover" data-theme={interfaceTheme} data-variant="anchored-context-popover">
  <header class="cxd-modals-anchored-context-popover__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-modals-anchored-context-popover__body">
    <p>Menú flotante compacto con separadores de 1px, iconos vectoriales alineados y sub-acciones.</p>
    <slot />
  </div>
</section>
