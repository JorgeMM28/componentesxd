---
/**
 * ============================================================================
 * COMPONENTESXD — 05. Full-Width Incident & Maintenance Strip (ASTRO 5)
 * Archivo: components/toasts/variants/system-banner-strip/SystemBannerStrip.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '05. Full-Width Incident & Maintenance Strip',
  badge = 'STATUS BAR',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-toasts-system-banner-strip" data-theme={interfaceTheme} data-variant="system-banner-strip">
  <header class="cxd-toasts-system-banner-strip__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-toasts-system-banner-strip__body">
    <p>Barra estructural superior para anuncios de mantenimiento, degradación de SLA o nuevas versiones.</p>
    <slot />
  </div>
</section>
