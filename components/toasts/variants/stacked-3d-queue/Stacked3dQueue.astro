---
/**
 * ============================================================================
 * COMPONENTESXD — 02. 3D Perspective Stacked Toast Queue (ASTRO 5)
 * Archivo: components/toasts/variants/stacked-3d-queue/Stacked3dQueue.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '02. 3D Perspective Stacked Toast Queue',
  badge = 'STACKED QUEUE',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-toasts-stacked-3d-queue" data-theme={interfaceTheme} data-variant="stacked-3d-queue">
  <header class="cxd-toasts-stacked-3d-queue__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-toasts-stacked-3d-queue__body">
    <p>Cola de notificaciones apiladas en profundidad 3D que se despliegan en abanico al pasar el cursor.</p>
    <slot />
  </div>
</section>
