---
/**
 * ============================================================================
 * COMPONENTESXD — 01. Dynamic Island Morphing Capsule (ASTRO 5)
 * Archivo: components/toasts/variants/dynamic-island-capsule/DynamicIslandCapsule.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '01. Dynamic Island Morphing Capsule',
  badge = 'MORPHING CAPSULE',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-toasts-dynamic-island-capsule" data-theme={interfaceTheme} data-variant="dynamic-island-capsule">
  <header class="cxd-toasts-dynamic-island-capsule__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-toasts-dynamic-island-capsule__body">
    <p>Cápsula superior que se expande suavemente entre estado reposo, procesamiento con onda de actividad y confirmación.</p>
    <slot />
  </div>
</section>
