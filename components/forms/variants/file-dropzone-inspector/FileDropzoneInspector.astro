---
/**
 * ============================================================================
 * COMPONENTESXD — 07. Drag & Drop Artifact Dropzone (ASTRO 5)
 * Archivo: components/forms/variants/file-dropzone-inspector/FileDropzoneInspector.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '07. Drag & Drop Artifact Dropzone',
  badge = 'FILE UPLOAD',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-forms-file-dropzone-inspector" data-theme={interfaceTheme} data-variant="file-dropzone-inspector">
  <header class="cxd-forms-file-dropzone-inspector__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-forms-file-dropzone-inspector__body">
    <p>Zona de carga con borde punteado reactivo, validación de extensión/tamaño y vista previa del archivo.</p>
    <slot />
  </div>
</section>
