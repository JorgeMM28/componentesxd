---
/**
 * ============================================================================
 * COMPONENTESXD — 04. Password Input + Live Entropy Analyzer (ASTRO 5)
 * Archivo: components/forms/variants/password-entropy-meter/PasswordEntropyMeter.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '04. Password Input + Live Entropy Analyzer',
  badge = 'SECURITY METER',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-forms-password-entropy-meter" data-theme={interfaceTheme} data-variant="password-entropy-meter">
  <header class="cxd-forms-password-entropy-meter__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-forms-password-entropy-meter__body">
    <p>Evalúa longitud, símbolos y entropía en tiempo real mediante 4 segmentos de estado y checklist SVG.</p>
    <slot />
  </div>
</section>
