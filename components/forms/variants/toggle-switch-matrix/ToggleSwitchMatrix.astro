---
/**
 * ============================================================================
 * COMPONENTESXD — 08. Industrial Toggle Switch & Radio Cards (ASTRO 5)
 * Archivo: components/forms/variants/toggle-switch-matrix/ToggleSwitchMatrix.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '08. Industrial Toggle Switch & Radio Cards',
  badge = 'SWITCHES',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-forms-toggle-switch-matrix" data-theme={interfaceTheme} data-variant="toggle-switch-matrix">
  <header class="cxd-forms-toggle-switch-matrix__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-forms-toggle-switch-matrix__body">
    <p>Interruptores binarios de baja latencia y tarjetas de selección exclusiva con indicador activo.</p>
    <slot />
  </div>
</section>
