---
import './styles.css';
---
<section class="cxd-special cxd-special--config" data-cxd-control="goals-board"><header><small>TABLERO DE OBJETIVOS</small><h3>Tablero de objetivos</h3></header><p data-copy>Objetivos restaurados</p><div class="cxd-special__scene" data-scene data-shape="config"><div class="cxd-special__actions" data-items><button type="button" data-item="0" aria-pressed="true">Documentación</button><button type="button" data-item="1" aria-pressed="false">Onboarding</button><button type="button" data-item="2" aria-pressed="false">Accesibilidad</button></div><strong data-output>Documentación</strong></div><div class="cxd-special__actions"><button type="button" data-primary>Completar hito</button><button type="button" data-reset>Restaurar</button></div><span role="status">Objetivos restaurados</span></section>
<script>
import { mountGoalsBoard } from './goals-board.js';
document.querySelectorAll('[data-cxd-control="goals-board"]:not([data-ready])').forEach(root => { root.dataset.ready = 'true'; mountGoalsBoard(root); });
</script>
