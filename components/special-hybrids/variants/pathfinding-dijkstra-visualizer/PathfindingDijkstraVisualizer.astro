---
import './styles.css';
---
<div class="cxd-special" data-cxd-control="pathfinding-dijkstra-visualizer"><h3>Explorador de rutas</h3><div class="cxd-special__scene" data-scene><small data-phase>LISTO</small><strong data-value>0 / 3</strong><p data-copy>Demostración autónoma: ejecuta la acción para actualizar el escenario.</p><div class="cxd-special__progress"><span data-progress></span></div></div><div class="cxd-special__actions"><button type="button" data-run>Buscar ruta</button><button type="button" data-reset>Reiniciar</button></div><span role="status">Laberinto restaurado</span></div>
<script>
import { mountPathfindingDijkstraVisualizer } from './pathfinding-dijkstra-visualizer.js';
document.querySelectorAll('[data-cxd-control="pathfinding-dijkstra-visualizer"]:not([data-ready])').forEach(root => { root.dataset.ready = 'true'; mountPathfindingDijkstraVisualizer(root); });
</script>
