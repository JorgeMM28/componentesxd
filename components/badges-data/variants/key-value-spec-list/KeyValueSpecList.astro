---
/**
 * ============================================================================
 * COMPONENTESXD — 04. Architectural Key-Value Description Grid (ASTRO 5)
 * Archivo: components/badges-data/variants/key-value-spec-list/KeyValueSpecList.astro
 * ============================================================================
 */
import './styles.css';

interface Props {
  title?: string;
  badge?: string;
  interfaceTheme?: string;
}

const {
  title = '04. Architectural Key-Value Description Grid',
  badge = 'SPEC LIST',
  interfaceTheme
} = Astro.props;
---

<section class="cxd-badges-data-key-value-spec-list" data-theme={interfaceTheme} data-variant="key-value-spec-list">
  <header class="cxd-badges-data-key-value-spec-list__header">
    <span>{title}</span>
    <span class="cxd-badge">{badge}</span>
  </header>
  <div class="cxd-badges-data-key-value-spec-list__body">
    <p>Lista estructurada de propiedades técnicas con líneas guía punteadas y copiado rápido por valor.</p>
    <slot />
  </div>
</section>
