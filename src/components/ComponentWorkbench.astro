---
import Icon from './Icon.astro';
import LiveComponentPreview from './LiveComponentPreview.astro';
import registry from '../data/vaultRegistry.json';
import { readRepoFile } from '../utils/repoReader';

interface Props {
  category: (typeof registry.componentCategories)[number];
}

const { category } = Astro.props;
const frameworks = registry.frameworks;
const dockerExamples: Record<string, { id: string; label: string; path: string }[]> = {
  'astro-node-ssr': [{ id: 'dockerfile', label: 'Dockerfile · Astro Node standalone', path: 'components/docker/node-ssr-stack/Dockerfile' }],
  'laravel-livewire-fpm': [{ id: 'dockerfile', label: 'Dockerfile · Laravel PHP-FPM', path: 'components/docker/laravel-livewire-blade/Dockerfile' }],
  'spa-nginx-alpine': [{ id: 'dockerfile', label: 'Dockerfile · SPA estática', path: 'components/docker/static-nginx/Dockerfile' }, { id: 'nginx', label: 'nginx.conf · SPA', path: 'components/docker/static-nginx/nginx.conf' }],
  'fullstack-compose-stack': [{ id: 'compose', label: 'Compose · aplicación, PostgreSQL y Redis', path: 'components/docker/fullstack-compose/docker-compose.yml' }],
  'bun-microservice': [{ id: 'dockerfile', label: 'Dockerfile · Bun', path: 'components/docker/bun-service/Dockerfile' }],
  'traefik-tls-proxy': [{ id: 'compose', label: 'Compose · Traefik y HTTPS', path: 'components/docker/traefik-tls/compose.yaml' }]
};
---

<div class="workbench" data-workbench-cat={category.slug}>
  <div class="variant-search">
    <label for={`variant-search-${category.slug}`}>Buscar en {category.name}</label>
    <input id={`variant-search-${category.slug}`} type="search" data-variant-search placeholder="Nombre, característica o uso…" autocomplete="off" />
    <span data-variant-search-count role="status">{category.variants.length} variantes</span>
  </div>
  <!-- ÍNDICE RÁPIDO DE ANCLAS PARA SALTAR A CADA VARIANTE EN LA PÁGINA -->
  <nav class="variant-jump-strip" aria-label="Variantes en esta página">
    <span class="variant-jump-strip__label">En esta página ({category.variants.length} variantes):</span>
    <div class="variant-jump-strip__pills">
      {category.variants.map((v, idx) => (
        <a href={`#${v.id}`} class="jump-pill" data-variant-jump={v.id}>
          <span class="jump-pill__num">{String(idx + 1).padStart(2, '0')}</span>
          <span>{v.name.replace(/^Variante \d+ — /, '')}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- LISTA COMPLETA DE VARIANTES EN ANCHO COMPLETO (UNA DEBAJO DE OTRA) -->
  <div class="variant-full-stack">
    {category.variants.map((variant, vIdx) => {
      const examples = category.slug === 'docker' ? [...(dockerExamples[variant.id] || []), { id: 'dockerignore', label: '.dockerignore · guardar con este nombre', path: 'components/docker/.dockerignore.example' }] : [];
      const filesMap = { ...((variant as any).files || {}) };
      examples.forEach(file => { filesMap[file.id] = { ...file, code: readRepoFile(file.path) }; });
      const availableFrameworks = [...examples, ...frameworks];
      const defaultFw = availableFrameworks[0].id;
      const defaultFile = filesMap[defaultFw];

      return (
        <section class="variant-showcase-block" id={variant.id} data-variant-card={variant.id} data-search-text={`${variant.name} ${variant.desc} ${variant.badge}`}>
          <!-- 1. CABECERA DE LA VARIANTE -->
          <header class="variant-showcase-block__head">
            <div class="variant-head-main">
              <span class="variant-index-badge">{String(vIdx + 1).padStart(2, '0')} // {variant.badge}</span>
              <h2>{variant.name}</h2>
              <p>{variant.desc}</p>
            </div>
          </header>

          <!-- 2. PREVISUALIZACIÓN EN VIVO EN ANCHO COMPLETO -->
          <div class="variant-showcase-block__stage" data-unit-canvas>
            <LiveComponentPreview
              previewType={variant.previewType}
              variantId={variant.id}
              variantName={variant.name}
              badge={variant.badge}
            />
          </div>

          <p class="codebar-notice">{category.slug === 'docker' ? 'El ejemplo de Docker seleccionado requiere un proyecto compatible; revisa los comentarios y copia los archivos auxiliares indicados.' : category.slug === 'special-hybrids' ? 'Ejemplo interactivo adaptable: instala animejs y copia styles.css junto con el módulo Vanilla JS; los demás adaptadores reutilizan la misma lógica y limpian sus recursos al desmontarse.' : category.slug === 'carousels' ? 'Ejemplo funcional adaptable, inspirado en la vista previa: copia styles.css y el módulo Vanilla JS y ajusta las rutas de assets a tu proyecto.' : ['buttons', 'toasts', 'forms', 'cards', 'badges-data', 'modals', 'navigation', 'accordions-tabs', 'tables'].includes(category.slug) ? 'Implementación funcional: copia también styles.css y, en los adaptadores que lo indiquen, el módulo Vanilla JS. Ajusta las rutas de assets a tu proyecto.' : 'El archivo generado es una plantilla inicial; puede diferir de la vista previa y requerir adaptación.'}</p>

          <!-- 3. BARRA INFERIOR CON LISTA DESPLEGABLE EXCLUSIVA PARA EL CÓDIGO DEL FRAMEWORK -->
          <footer class="variant-showcase-block__codebar">
            <div class="codebar-left">
              <div class="select-control">
                <label class="select-control__label">
                  <Icon name="code" size={14} />
                  <span>Código por Framework:</span>
                </label>
                <div class="select-wrap">
                  <select class="cxd-architect-select" data-unit-fw-select aria-label={`Framework para ${variant.name}`}>
                    {availableFrameworks.map((fw) => (
                      <option value={fw.id}>{fw.label}</option>
                    ))}
                  </select>
                  <Icon name="chevron-down" size={12} class="select-chevron" />
                </div>
              </div>

              <code class="codebar-path" data-unit-path>{defaultFile?.path}</code>
            </div>

            <div class="codebar-actions">
              <button type="button" class="unit-action-btn" data-toggle-code aria-expanded="false">
                <Icon name="code" size={13} />
                <span data-toggle-label>Ver / Ocultar Código</span>
              </button>

              <button type="button" class="unit-action-btn unit-action-btn--primary" data-copy-unit-code>
                <Icon name="copy" size={13} />
                <span data-copy-label>Copiar Código</span>
              </button>
            </div>
          </footer>

          <!-- 4. CAJÓN DE CÓDIGO FUENTE DEL FRAMEWORK SELECCIONADO -->
          <div class="variant-unit__code-drawer is-collapsed" data-code-drawer>
            <div class="code-drawer__meta">
              <span>Comando para copiar desde la raíz del proyecto:</span>
              <code class="mono-cp" data-unit-cp>cp {defaultFile?.path} ./tu-proyecto/</code>
            </div>

            {availableFrameworks.map((fw, idx) => {
              const f = filesMap[fw.id];
              return (
                <pre
                  class={`unit-code-block ${idx === 0 ? 'is-active' : ''}`}
                  data-fw-panel={fw.id}
                  data-file-path={f?.path}
                ><code>{f?.code}</code></pre>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>
</div>

<script>
  import { animate, stagger, createTimeline, createTimer, createSpring, svg } from 'animejs';
  import { initMagneticButtons, bindAsyncButton } from '../../components/buttons/vanilla-js/MagneticButton.js';
  import { initSpotlightCards } from '../../components/cards/vanilla-js/SpotlightCard.js';

  document.querySelectorAll<HTMLElement>('[data-workbench-cat]').forEach(workbench => {
    const search = workbench.querySelector<HTMLInputElement>('[data-variant-search]');
    const count = workbench.querySelector<HTMLElement>('[data-variant-search-count]');
    const cards = Array.from(workbench.querySelectorAll<HTMLElement>('[data-variant-card]'));
    const normalize = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    search?.addEventListener('input', () => {
      const terms = normalize(search.value).trim().split(/\s+/).filter(Boolean);
      let visible = 0;
      cards.forEach(card => {
        const text = normalize(card.dataset.searchText || '');
        const matches = terms.every(term => text.includes(term));
        card.hidden = !matches;
        const link = workbench.querySelector<HTMLElement>(`[data-variant-jump="${CSS.escape(card.dataset.variantCard || '')}"]`);
        if (link) link.hidden = !matches;
        if (matches) visible++;
      });
      if (count) count.textContent = `${visible} ${visible === 1 ? 'variante' : 'variantes'}`;
    });
  });

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  function pauseOutsideViewport(target: HTMLElement, animation: { pause: () => unknown; play: () => unknown }) {
    if (reducedMotion.matches) { animation.pause(); return; }
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (entry.isIntersecting) animation.play(); else animation.pause();
    }), { rootMargin: '100px' });
    observer.observe(target);
  }

  initMagneticButtons();
  initSpotlightCards();

  document.querySelectorAll<HTMLElement>('[data-special-preview]').forEach(preview => {
    let step = 0;
    let motion: ReturnType<typeof animate> | undefined;
    const value = preview.querySelector<HTMLElement>('[data-special-value]');
    const state = preview.querySelector<HTMLElement>('[data-special-state]');
    const status = preview.querySelector<HTMLElement>('[data-special-status]');
    const meter = preview.querySelector<HTMLElement>('[data-special-meter]');
    const canvas = preview.querySelector<HTMLElement>('[data-special-canvas]');
    const render = (message: string) => {
      if (value) value.textContent = `${step} / 3`;
      if (state) state.textContent = step === 3 ? 'COMPLETO' : step ? 'EJECUTANDO' : 'LISTO';
      if (status) status.textContent = message;
      meter?.style.setProperty('--special-progress', `${step / 3 * 100}%`);
      motion?.pause();
      if (!reducedMotion.matches && canvas) motion = animate(canvas.children, { opacity: [0.35, 1], y: [12, 0], delay: stagger(60), duration: 360, ease: 'outCubic' });
    };
    preview.querySelector<HTMLButtonElement>('[data-special-run]')?.addEventListener('click', () => { step = step === 3 ? 1 : step + 1; render(step === 3 ? 'Acción completada' : `Procesando paso ${step} de 3`); });
    preview.querySelector<HTMLButtonElement>('[data-special-reset]')?.addEventListener('click', () => { step = 0; render('Escenario reiniciado'); });
    render('Sin cambios');
  });

  document.querySelectorAll<HTMLElement>('[data-async-demo]').forEach((btn) => {
    bindAsyncButton(btn, () => new Promise((r) => setTimeout(r, 950)));
  });

  // 1. Tabla Interactiva (Sort + Selección en vivo)
  document.querySelectorAll<HTMLElement>('[data-interactive-table]').forEach((tbl) => {
    const tbody = tbl.querySelector('tbody');
    const counter = tbl.querySelector('[data-sel-counter]');
    const checkAll = tbl.querySelector<HTMLInputElement>('[data-check-all]');
    const clearBtn = tbl.querySelector('[data-clear-sel]');
    let sortAsc = true;

    function updateSelectionCount() {
      const checks = Array.from(tbl.querySelectorAll<HTMLInputElement>('[data-row-check]'));
      const selected = checks.filter((c) => c.checked).length;
      checks.forEach((c) => c.closest('tr')?.classList.toggle('is-selected', c.checked));
      if (counter) counter.textContent = `${selected} de ${checks.length} filas seleccionadas`;
    }

    tbl.addEventListener('change', updateSelectionCount);

    checkAll?.addEventListener('change', () => {
      tbl.querySelectorAll<HTMLInputElement>('[data-row-check]').forEach((c) => {
        c.checked = checkAll.checked;
      });
      updateSelectionCount();
    });

    clearBtn?.addEventListener('click', () => {
      if (checkAll) checkAll.checked = false;
      tbl.querySelectorAll<HTMLInputElement>('[data-row-check]').forEach((c) => {
        c.checked = false;
      });
      updateSelectionCount();
    });

    tbl.querySelectorAll<HTMLElement>('[data-sort-col]').forEach((th) => {
      th.addEventListener('click', () => {
        if (!tbody) return;
        const colIdx = Number(th.dataset.sortCol || 0) + 1;
        const rows = Array.from(tbody.querySelectorAll('tr'));
        sortAsc = !sortAsc;
        rows.sort((a, b) => {
          const vA = a.children[colIdx]?.getAttribute('data-val') || '';
          const vB = b.children[colIdx]?.getAttribute('data-val') || '';
          const nA = Number(vA);
          const nB = Number(vB);
          const cmp = !Number.isNaN(nA) && !Number.isNaN(nB) ? nA - nB : vA.localeCompare(vB);
          return sortAsc ? cmp : -cmp;
        });
        rows.forEach((r) => tbody.appendChild(r));
        animate(rows, { opacity: [0.3, 1], x: [-10, 0], duration: 280, delay: stagger(45), ease: 'outQuad' });
      });
    });
  });

  // 2. Tabla con Acciones CRUD (Alternar, Duplicar, Eliminar y Agregar con Anime.js)
  document.querySelectorAll<HTMLElement>('[data-crud-table]').forEach((crud) => {
    const tbody = crud.querySelector<HTMLElement>('[data-crud-tbody]');
    const addBtn = crud.querySelector('[data-add-crud-row]');

    addBtn?.addEventListener('click', () => {
      if (!tbody) return;
      const tr = document.createElement('tr');
      const rand = Math.floor(100 + Math.random() * 899);
      tr.innerHTML = `
        <td><strong>/api/v2/edge/worker-${rand}</strong></td>
        <td class="mono">production</td>
        <td><span class="cxd-badge cxd-badge--active" data-status-pill>ACTIVE</span></td>
        <td style="text-align:right">
          <div class="row-actions">
            <button type="button" class="mini-btn" data-row-toggle>Alternar Estado</button>
            <button type="button" class="mini-btn" data-row-dup>Duplicar</button>
            <button type="button" class="mini-btn mini-btn--danger" data-row-del>Eliminar</button>
          </div>
        </td>
      `;
      tbody.appendChild(tr);
      animate(tr, { opacity: [0, 1], y: [-12, 0], duration: 320, ease: 'outExpo' });
    });

    tbody?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const tr = target.closest('tr');
      if (!tr) return;

      if (target.hasAttribute('data-row-toggle')) {
        const pill = tr.querySelector('[data-status-pill]');
        if (pill) {
          const isAct = pill.textContent === 'ACTIVE';
          pill.textContent = isAct ? 'PAUSED' : 'ACTIVE';
          pill.className = `cxd-badge ${isAct ? 'cxd-badge--pending' : 'cxd-badge--active'}`;
        }
      } else if (target.hasAttribute('data-row-dup')) {
        const clone = tr.cloneNode(true) as HTMLElement;
        tr.after(clone);
        animate(clone, { opacity: [0, 1], scale: [0.96, 1], duration: 280, ease: 'outBack' });
      } else if (target.hasAttribute('data-row-del')) {
        animate(tr, {
          opacity: [1, 0],
          x: [0, 30],
          duration: 220,
          ease: 'inQuad',
          onComplete: () => tr.remove()
        });
      }
    });
  });

  // 3. Tabla con Formulario Integrado y Cálculo Automático
  document.querySelectorAll<HTMLElement>('[data-form-table]').forEach((ft) => {
    const grandTotalEl = ft.querySelector('[data-table-grand-total]');
    function recalcTable() {
      let total = 0;
      ft.querySelectorAll<HTMLElement>('[data-calc-row]').forEach((row) => {
        const price = Number(row.querySelector<HTMLSelectElement>('[data-row-price]')?.value || 0);
        const qty = Number(row.querySelector<HTMLInputElement>('[data-row-qty]')?.value || 0);
        const sub = price * qty;
        total += sub;
        const unitEl = row.querySelector('[data-unit-display]');
        const subEl = row.querySelector('[data-row-subtotal]');
        if (unitEl) unitEl.textContent = `$${price.toFixed(2)}`;
        if (subEl) subEl.textContent = `$${sub.toFixed(2)}`;
      });
      if (grandTotalEl) grandTotalEl.textContent = `$${total.toFixed(2)}`;
    }
    ft.addEventListener('input', recalcTable);
    ft.addEventListener('change', recalcTable);
  });

  // 4. Tabla con Filtros Combinados
  document.querySelectorAll<HTMLElement>('[data-multi-filter-table]').forEach((mft) => {
    const searchInp = mft.querySelector<HTMLInputElement>('[data-mf-search]');
    const roleSel = mft.querySelector<HTMLSelectElement>('[data-mf-role]');
    const statusBtns = mft.querySelectorAll<HTMLButtonElement>('[data-mf-status]');
    const rows = mft.querySelectorAll<HTMLElement>('tbody tr');
    let activeStatus = 'all';

    function filterRows() {
      const q = (searchInp?.value || '').toLowerCase();
      const role = roleSel?.value || 'all';
      rows.forEach((r) => {
        const matchQ = !q || (r.textContent || '').toLowerCase().includes(q);
        const matchR = role === 'all' || r.dataset.role === role;
        const matchS = activeStatus === 'all' || r.dataset.status === activeStatus;
        r.style.display = matchQ && matchR && matchS ? '' : 'none';
      });
    }

    searchInp?.addEventListener('input', filterRows);
    roleSel?.addEventListener('change', filterRows);
    statusBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeStatus = btn.dataset.mfStatus || 'all';
        statusBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
        filterRows();
      });
    });
  });

  // 5. Toasters Interactivos
  document.querySelectorAll<HTMLElement>('[data-modern-toast]').forEach((mt) => {
    const fill = mt.querySelector<HTMLElement>('[data-toast-fill]');
    const btn = mt.querySelector('[data-replay-toast-bar]');
    const runBar = () => {
      if (fill) animate(fill, { scaleX: [1, 0], duration: 3500, ease: 'linear' });
    };
    runBar();
    btn?.addEventListener('click', runBar);
  });

  document.querySelectorAll<HTMLElement>('[data-island-shell]').forEach((shell) => {
    const title = shell.querySelector('[data-island-state-title]');
    const body = shell.querySelector<HTMLElement>('[data-island-body]');
    shell.querySelectorAll<HTMLButtonElement>('[data-island-mode]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const exp = btn.dataset.islandMode === 'expanded';
        if (body) body.hidden = !exp;
        if (title) title.textContent = exp ? 'DESPLIEGUE ACTIVO // 12 REGIONES' : 'MODO COMPACTO // IDLE';
        animate(shell, { scale: [0.96, 1], duration: 320, ease: 'outBack' });
      });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-toast-spawner]').forEach((sp) => {
    const list = sp.querySelector<HTMLElement>('[data-spawn-list]');
    sp.querySelectorAll<HTMLButtonElement>('[data-spawn-type]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!list) return;
        const type = btn.dataset.spawnType;
        const card = document.createElement('div');
        card.className = 'cxd-toast-card';
        const badgeClass = type === 'ok' ? 'cxd-badge--active' : type === 'warn' ? 'cxd-badge--pending' : 'cxd-badge--failed';
        const label = type === 'ok' ? 'DESPLIEGUE EXITOSO' : type === 'warn' ? 'LATENCIA ELEVADA' : 'ERROR DE CONEXIÓN';
        card.innerHTML = `
          <span>${label} · ${new Date().toLocaleTimeString()}</span>
          <span class="cxd-badge ${badgeClass}">${type?.toUpperCase()}</span>
        `;
        list.prepend(card);
        if (list.children.length > 3) list.lastElementChild?.remove();
        animate(card, { opacity: [0, 1], y: [-14, 0], scale: [0.94, 1], duration: 320, ease: 'outBack' });
      });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-upload-toast]').forEach((ut) => {
    const pctEl = ut.querySelector('[data-up-pct]');
    const barEl = ut.querySelector<HTMLElement>('[data-up-bar]');
    ut.querySelector('[data-up-sim]')?.addEventListener('click', () => {
      const state = { p: 0 };
      animate(state, {
        p: 100,
        duration: 1600,
        ease: 'outExpo',
        onUpdate: () => {
          const v = Math.round(state.p);
          if (pctEl) pctEl.textContent = `${v}%`;
          if (barEl) barEl.style.width = `${v}%`;
        }
      });
    });
  });

  // 6. FAB Radial, 3D Tilt Card, Tabbed Card, OTP & Password Meter + ALL Interactive Variants
  document.querySelectorAll<HTMLElement>('[data-expandable-table]').forEach((table) => {
    table.querySelectorAll<HTMLElement>('[data-exp-row]').forEach((row) => {
      const detail = row.nextElementSibling as HTMLElement | null;
      const toggle = () => { if (detail) { detail.hidden = !detail.hidden; row.setAttribute('aria-expanded', String(!detail.hidden)); } };
      row.tabIndex = 0;
      row.setAttribute('role', 'button');
      row.setAttribute('aria-expanded', String(detail ? !detail.hidden : false));
      row.addEventListener('click', toggle);
      row.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggle(); } });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-action-toast]').forEach((toast) => {
    const message = toast.querySelector<HTMLElement>('[data-action-toast-msg]');
    toast.querySelectorAll<HTMLButtonElement>('[data-at-btn]').forEach(button => button.addEventListener('click', () => {
      if (message) message.textContent = button.dataset.atBtn || '';
      animate(toast, { scale: [0.98, 1.02, 1], duration: 320, ease: 'outBack' });
    }));
  });

  document.querySelectorAll<HTMLElement>('[data-form-toast]').forEach((toast) => {
    const form = toast.querySelector<HTMLFormElement>('[data-ft-form]');
    const input = toast.querySelector<HTMLInputElement>('[data-ft-inp]');
    const status = toast.querySelector<HTMLElement>('[data-ft-time]');
    form?.addEventListener('submit', event => {
      event.preventDefault();
      if (!input?.value.trim()) return;
      if (status) status.textContent = `Respuesta enviada: ${input.value.trim()}`;
      input.value = '';
      animate(toast, { y: [-4, 0], duration: 300, ease: 'outBack' });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-pill-toast]').forEach((stage) => {
    stage.querySelector('[data-pt-btn]')?.addEventListener('click', () => {
      const message = stage.querySelector<HTMLElement>('[data-pt-text]');
      if (message) message.textContent = 'Notificación leída';
      animate(stage, { scale: [0.95, 1], duration: 300, ease: 'outBack' });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-btn-modern-group]').forEach((grp) => {
    const status = grp.querySelector<HTMLElement>('[data-pill-status]');
    grp.querySelectorAll<HTMLButtonElement>('[data-pill-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        grp.querySelectorAll('[data-pill-btn]').forEach((b) => b.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        if (status) status.textContent = `ACCIÓN EJECUTADA: ${btn.dataset.pillBtn}`;
        animate(btn, { scale: [0.94, 1.04, 1], duration: 280, ease: 'outBack' });
      });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-btn-styleless-group]').forEach((grp) => {
    const status = grp.querySelector<HTMLElement>('[data-styleless-status]');
    grp.querySelectorAll<HTMLButtonElement>('[data-styleless-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        grp.querySelectorAll('[data-styleless-btn]').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        if (status) status.textContent = `RUTA ACTIVA: ${btn.dataset.stylelessBtn}`;
        animate(btn, { x: [0, 5, 0], duration: 260, ease: 'outQuad' });
      });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-fab-stage]').forEach((st) => {
    const items = st.querySelector<HTMLElement>('[data-fab-items]');
    const status = st.querySelector<HTMLElement>('[data-fab-readout]');
