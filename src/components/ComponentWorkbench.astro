  // H21: Escenario Relojería Cinética & Onda Radial (Estilo Hero Oficial de Anime.js v4)
  document.querySelectorAll<HTMLElement>('[data-hyb-21]').forEach((h) => {
    const rays = h.querySelectorAll<HTMLElement>('[data-h21-ray]');
    const dots = h.querySelectorAll<HTMLElement>('[data-h21-dot]');
    const halo = h.querySelector<HTMLElement>('[data-h21-halo]');
    const label = h.querySelector('[data-h21-label]');
    const btns = h.querySelectorAll<HTMLButtonElement>('[data-h21-mode]');

    if (halo) {
      pauseOutsideViewport(h, animate(halo, { scale: [0.92, 1.06, 0.92], opacity: [0.35, 0.85, 0.35], duration: 3200, loop: true, ease: 'inOutSine' }));
    }

    function runHeroMode(mode: string) {
      if (label) label.textContent = mode.toUpperCase();
      if (mode === 'clockwork') {
        animate(rays, {
          scaleY: [0.35, 1.55, 0.7, 1],
          translateY: [0, -16, 0],
          delay: stagger(20, { from: 'first' }),
          duration: 1050,
          ease: 'outBack'
        });
        animate(dots, {
          scale: [0.3, 1.18, 1],
          rotate: ['0deg', '90deg'],
          delay: stagger(26, { grid: [6, 6], from: 'center' }),
          duration: 900,
          ease: 'outBack'
        });
      } else if (mode === 'solar') {
        animate(rays, {
          scaleY: [0.2, 2.05, 0.9],
          translateY: [0, -26, -6],
          delay: stagger(14, { from: 'center' }),
          duration: 840,
          ease: createSpring({ mass: 1, stiffness: 150, damping: 8 })
        });
        animate(dots, {
          scale: [1, 0.2, 1.28, 1],
          borderRadius: ['4px', '50%', '4px'],
          delay: stagger(30, { grid: [6, 6], from: 'center' }),
          duration: 920,
          ease: 'inOutQuad'
        });
      } else if (mode === 'vortex') {
        animate(rays, {
          rotate: [-32, 32, 0],
          scaleY: [1, 1.65, 1],
          delay: stagger(18),
          duration: 920,
          ease: 'inOutCubic'
        });
        animate(dots, {
          rotate: ['0deg', '180deg'],
          scale: [0.45, 1.15, 1],
          delay: stagger(24, { grid: [6, 6], from: 'first' }),
          duration: 860,
          ease: 'outExpo'
        });
      } else {
        animate(rays, {
          scaleY: [1, 0.25, 1.8, 1],
          opacity: [0.3, 1],
          delay: stagger(12, { from: 'last' }),
          duration: 760,
          ease: 'outExpo'
        });
        animate(dots, {
          scale: [1, 1.38, 0.6, 1],
          delay: stagger(26, { grid: [6, 6], from: 'last' }),
          duration: 780,
          ease: 'outBack'
        });
      }
    }

    runHeroMode('clockwork');

    btns.forEach((b) => {
      b.addEventListener('click', () => {
        btns.forEach((x) => x.classList.toggle('mini-btn--accent', x === b));
        runHeroMode(b.dataset.h21Mode || 'clockwork');
      });
    });
  });

  // H22: Mapa Mundial Interactivo con Rutas de Tráfico en Vivo y Paquetes MotionPath
  document.querySelectorAll<HTMLElement>('[data-hyb-22]').forEach((h) => {
    const arcs = Array.from(h.querySelectorAll<SVGPathElement>('[data-h22-arc]'));
    const pkts = Array.from(h.querySelectorAll<SVGCircleElement>('[data-h22-pkt]'));
    const ping = h.querySelector<SVGCircleElement>('[data-h22-ping]');
    const focus = h.querySelector<SVGCircleElement>('[data-h22-focus]');
    const status = h.querySelector('[data-h22-status]');
    const btns = h.querySelectorAll<HTMLButtonElement>('[data-h22-hub]');

    // Iniciar paquetes viajando continuamente por los arcos intercontinentales
    pkts.forEach((pkt, idx) => {
      const targetArc = arcs[idx % arcs.length];
      if (targetArc) {
        try {
          const mp = svg.createMotionPath(targetArc);
          animate(pkt, {
            ...mp,
            duration: 2400 + idx * 550,
            ease: 'inOutSine',
            loop: true
          });
        } catch {
          // Fallback suave si el navegador aún no mide el path
        }
      }
    });

    function triggerWorldTraffic(cx: string, cy: string, name: string) {
      if (ping && focus) {
        ping.setAttribute('cx', cx);
        ping.setAttribute('cy', cy);
        focus.setAttribute('cx', cx);
        focus.setAttribute('cy', cy);
        animate(ping, { r: [6, 40], opacity: [1, 0], duration: 950, ease: 'outExpo' });
      }
      if (arcs.length) {
        animate(svg.createDrawable(arcs), {
          draw: ['0 0', '0 1'],
          duration: 850,
          delay: stagger(110),
          ease: 'outQuart'
        });
      }
      if (status) {
        const rate = (1.2 + Math.random() * 1.6).toFixed(2);
        status.textContent = `HUB ACTIVO: ${name} · ${rate}M PAQUETES/S`;
      }
    }

    btns.forEach((b) => {
      b.addEventListener('click', () => {
        btns.forEach((x) => x.classList.toggle('mini-btn--accent', x === b));
        triggerWorldTraffic(b.dataset.x || '565', b.dataset.y || '88', b.dataset.name || 'TOKYO');
      });
    });
  });

  // H23: Visualizador Interactivo de Algoritmo Pathfinding A* / BFS (24x10 = 240 Micro-Celdas, Caminos Largos)
  document.querySelectorAll<HTMLElement>('[data-hyb-23]').forEach((h) => {
    const cells = Array.from(h.querySelectorAll<HTMLButtonElement>('[data-pf-idx]'));
    const info = h.querySelector('[data-h23-info]');
    const stepsBadge = h.querySelector('[data-h23-steps-badge]');
    const visitedBadge = h.querySelector('[data-h23-visited-badge]');
    const cols = 24;
    const rows = 10;
    const total = cols * rows; // 240
    const endIdx = total - 1;  // 239
    let activeTimers: ReturnType<typeof setTimeout>[] = [];

    function cancelTimers() {
      activeTimers.forEach((t) => clearTimeout(t));
      activeTimers = [];
    }

    function clearVisited() {
      cancelTimers();
      cells.forEach((c) => c.classList.remove('is-visited', 'is-path'));
    }

    cells.forEach((c, idx) => {
      c.addEventListener('click', () => {
        if (idx === 0 || idx === endIdx) return;
        clearVisited();
        c.classList.toggle('is-wall');
      });
    });

    function buildSerpentineLabyrinth() {
      clearVisited();
      cells.forEach((cell, idx) => {
        if (idx === 0 || idx === endIdx) return;
        const r = Math.floor(idx / cols);
        const c = idx % cols;
        const w1 = c === 4 && r < 8;
        const w2 = c === 9 && r > 1;
        const w3 = c === 14 && r < 8;
        const w4 = c === 19 && r > 1;
        cell.classList.toggle('is-wall', w1 || w2 || w3 || w4);
      });
      if (info) info.textContent = 'LABERINTO SERPENTEANTE DE CAMINO LARGO CARGADO';
    }

    h.querySelector('[data-h23-labyrinth]')?.addEventListener('click', () => {
      buildSerpentineLabyrinth();
      runPathfinding();
    });

    h.querySelector('[data-h23-clear]')?.addEventListener('click', () => {
      clearVisited();
      cells.forEach((c, i) => {
        if (i !== 0 && i !== endIdx) c.classList.remove('is-wall');
      });
      if (stepsBadge) stepsBadge.textContent = 'PASOS: --';
      if (visitedBadge) visitedBadge.textContent = 'EXPLORADOS: --';
      if (info) info.textContent = 'TABLERO LIMPIO (240 CELDAS) · HAZ CLIC PARA CREAR MUROS';
    });

    h.querySelector('[data-h23-maze]')?.addEventListener('click', () => {
      clearVisited();
      cells.forEach((c, i) => {
        if (i === 0 || i === endIdx) return;
        const r = Math.floor(i / cols);
        const col = i % cols;
        // Evitar bloquear la salida o entrada directa
        if ((r <= 1 && col <= 1) || (r >= rows - 2 && col >= cols - 2)) {
          c.classList.remove('is-wall');
          return;
        }
        c.classList.toggle('is-wall', Math.random() < 0.27);
      });
      if (info) info.textContent = 'OBSTÁCULOS DENSOS GENERADOS · EJECUTANDO BÚSQUEDA...';
      runPathfinding();
    });

    function runPathfinding() {
      clearVisited();
      const walls = new Set(cells.map((c, i) => (c.classList.contains('is-wall') ? i : -1)).filter((i) => i >= 0));
      const queue: number[] = [0];
      const cameFrom = new Map<number, number>();
      const visitedOrder: number[] = [];
      const seen = new Set<number>([0]);

      while (queue.length > 0) {
        const cur = queue.shift()!;
        if (cur === endIdx) break;
        const r = Math.floor(cur / cols);
        const c = cur % cols;
        const neighbors: number[] = [];
        if (c + 1 < cols) neighbors.push(r * cols + (c + 1));
        if (r + 1 < rows) neighbors.push((r + 1) * cols + c);
        if (r - 1 >= 0) neighbors.push((r - 1) * cols + c);
        if (c - 1 >= 0) neighbors.push(r * cols + (c - 1));

        for (const nb of neighbors) {
          if (!seen.has(nb) && !walls.has(nb)) {
            seen.add(nb);
            cameFrom.set(nb, cur);
            visitedOrder.push(nb);
            queue.push(nb);
          }
        }
      }

      const stepDelay = 7;
      visitedOrder.forEach((idx, step) => {
        const timer = setTimeout(() => {
          if (idx !== endIdx) cells[idx]?.classList.add('is-visited');
          if (visitedBadge) visitedBadge.textContent = `EXPLORADOS: ${step + 1}`;
        }, step * stepDelay);
        activeTimers.push(timer);
      });

      const path: number[] = [];
      if (cameFrom.has(endIdx)) {
        let cur = endIdx;
        while (cur !== 0) {
          path.unshift(cur);
          cur = cameFrom.get(cur)!;
        }
        path.unshift(0);
      }

      const finalTimer = setTimeout(() => {
        if (path.length > 0) {
          const pathEls = path.map((i) => cells[i]);
          pathEls.forEach((el) => el.classList.add('is-path'));
          animate(pathEls, {
            scale: [0.6, 1.18, 1],
            delay: stagger(16),
            duration: 320,
            ease: 'outBack'
          });
          if (stepsBadge) stepsBadge.textContent = `PASOS: ${path.length}`;
          if (visitedBadge) visitedBadge.textContent = `EXPLORADOS: ${visitedOrder.length}`;
          if (info) info.textContent = `RUTA ÓPTIMA ENCONTRADA EN ${path.length} PASOS (${visitedOrder.length} NODOS EXPLORADOS)`;
        } else {
          if (stepsBadge) stepsBadge.textContent = 'SIN RUTA';
          if (info) info.textContent = 'CAMINO BLOQUEADO · HAZ CLIC EN UN MURO PARA ABRIR PASO';
        }
      }, visitedOrder.length * stepDelay + 60);
      activeTimers.push(finalTimer);
    }

    h.querySelector('[data-h23-run]')?.addEventListener('click', () => runPathfinding());
  });

  // H24: Visualizador de Algoritmos de Ordenamiento Paso a Paso en Tiempo Real (QuickSort, BubbleSort, SelectionSort, InsertionSort)
  document.querySelectorAll<HTMLElement>('[data-hyb-24]').forEach((h) => {
    const cols = Array.from(h.querySelectorAll<HTMLElement>('[data-h24-col]'));
    const status = h.querySelector('[data-h24-status]');
    const cmpBadge = h.querySelector('[data-h24-cmp]');
    const swpBadge = h.querySelector('[data-h24-swp]');
    const btns = h.querySelectorAll<HTMLButtonElement>('.mini-btn');
    let currentRunId = 0;

    type SortStep =
      | { type: 'cmp'; i: number; j: number; pivot?: number }
      | { type: 'set'; idx: number; val: number }
      | { type: 'swap'; i: number; j: number; valI: number; valJ: number };

    function setColValue(idx: number, val: number) {
      const col = cols[idx];
      if (!col) return;
      col.dataset.val = String(val);
      const bar = col.querySelector<HTMLElement>('.sort-col-bar');
      const num = col.querySelector('.sort-col-num');
      if (bar) bar.style.height = `${val}%`;
      if (num) num.textContent = String(val);
    }

    function clearHighlights() {
      cols.forEach((c) => c.classList.remove('is-comparing', 'is-pivot', 'is-sorted'));
    }

    function generateQuickSortSteps(arr: number[]): SortStep[] {
      const steps: SortStep[] = [];
      const a = [...arr];
      function partition(low: number, high: number): number {
        const pivotVal = a[high];
        let i = low - 1;
        for (let j = low; j < high; j++) {
          steps.push({ type: 'cmp', i: j, j: high, pivot: high });
          if (a[j] < pivotVal) {
            i++;
            if (i !== j) {
              const tmp = a[i];
              a[i] = a[j];
              a[j] = tmp;
              steps.push({ type: 'swap', i, j, valI: a[i], valJ: a[j] });
            }
          }
        }
        if (i + 1 !== high) {
          const tmp = a[i + 1];
          a[i + 1] = a[high];
          a[high] = tmp;
          steps.push({ type: 'swap', i: i + 1, j: high, valI: a[i + 1], valJ: a[high] });
        }
        return i + 1;
      }
      function qs(low: number, high: number) {
        if (low < high) {
          const pi = partition(low, high);
          qs(low, pi - 1);
          qs(pi + 1, high);
        }
      }
      qs(0, a.length - 1);
      return steps;
    }

    function generateBubbleSortSteps(arr: number[]): SortStep[] {
      const steps: SortStep[] = [];
      const a = [...arr];
      for (let i = 0; i < a.length - 1; i++) {
        let swapped = false;
        for (let j = 0; j < a.length - i - 1; j++) {
          steps.push({ type: 'cmp', i: j, j: j + 1 });
          if (a[j] > a[j + 1]) {
            const tmp = a[j];
            a[j] = a[j + 1];
            a[j + 1] = tmp;
            swapped = true;
            steps.push({ type: 'swap', i: j, j: j + 1, valI: a[j], valJ: a[j + 1] });
          }
        }
        if (!swapped) break;
      }
      return steps;
    }

    function generateSelectionSortSteps(arr: number[]): SortStep[] {
      const steps: SortStep[] = [];
      const a = [...arr];
      for (let i = 0; i < a.length - 1; i++) {
        let minIdx = i;
        for (let j = i + 1; j < a.length; j++) {
          steps.push({ type: 'cmp', i: minIdx, j, pivot: i });
          if (a[j] < a[minIdx]) minIdx = j;
        }
        if (minIdx !== i) {
          const tmp = a[i];
          a[i] = a[minIdx];
          a[minIdx] = tmp;
          steps.push({ type: 'swap', i, j: minIdx, valI: a[i], valJ: a[minIdx] });
        }
      }
      return steps;
    }

    function generateInsertionSortSteps(arr: number[]): SortStep[] {
      const steps: SortStep[] = [];
      const a = [...arr];
      for (let i = 1; i < a.length; i++) {
        let j = i;
        while (j > 0) {
          steps.push({ type: 'cmp', i: j - 1, j, pivot: i });
          if (a[j - 1] > a[j]) {
            const tmp = a[j - 1];
            a[j - 1] = a[j];
            a[j] = tmp;
            steps.push({ type: 'swap', i: j - 1, j, valI: a[j - 1], valJ: a[j] });
            j--;
          } else {
            break;
          }
        }
      }
      return steps;
    }

    async function playSort(algo: string) {
      const runId = ++currentRunId;
      clearHighlights();
      const initialVals = cols.map((c) => Number(c.dataset.val || 50));
      const steps =
        algo === 'quick'
          ? generateQuickSortSteps(initialVals)
          : algo === 'selection'
            ? generateSelectionSortSteps(initialVals)
            : algo === 'insertion'
              ? generateInsertionSortSteps(initialVals)
              : generateBubbleSortSteps(initialVals);

      let comparisons = 0;
      let swaps = 0;
      if (cmpBadge) cmpBadge.textContent = 'COMPARACIONES: 0';
      if (swpBadge) swpBadge.textContent = 'INTERCAMBIOS: 0';
      const algoLabel = algo.toUpperCase() + 'SORT';
      if (status) status.textContent = `EJECUTANDO ${algoLabel} PASO A PASO...`;

      const stepMs = algo === 'bubble' ? 16 : 24;

      for (const st of steps) {
        if (runId !== currentRunId) return;
        cols.forEach((c) => c.classList.remove('is-comparing', 'is-pivot'));

        if (st.type === 'cmp') {
          comparisons++;
          if (cmpBadge) cmpBadge.textContent = `COMPARACIONES: ${comparisons}`;
          cols[st.i]?.classList.add('is-comparing');
          cols[st.j]?.classList.add('is-comparing');
          if (st.pivot !== undefined) cols[st.pivot]?.classList.add('is-pivot');
        } else if (st.type === 'swap') {
          swaps++;
          if (swpBadge) swpBadge.textContent = `INTERCAMBIOS: ${swaps}`;
          cols[st.i]?.classList.add('is-pivot');
          cols[st.j]?.classList.add('is-pivot');
          setColValue(st.i, st.valI);
          setColValue(st.j, st.valJ);
          animate([cols[st.i], cols[st.j]], { y: [-8, 0], duration: 90, ease: 'outQuad' });
        }

        await new Promise((r) => setTimeout(r, stepMs));
      }

      if (runId !== currentRunId) return;
      cols.forEach((c) => c.classList.remove('is-comparing', 'is-pivot'));

      // Barrido verde de verificación final
      cols.forEach((c, idx) => {
        setTimeout(() => {
          if (runId !== currentRunId) return;
          c.classList.add('is-sorted');
          animate(c, { y: [-12, 0], scaleY: [0.85, 1], duration: 240, ease: 'outBack' });
        }, idx * 18);
      });

      if (status) {
        status.textContent = `${algoLabel} COMPLETADO // ${comparisons} COMPARACIONES · ${swaps} INTERCAMBIOS`;
      }
    }

    h.querySelectorAll<HTMLButtonElement>('[data-h24-sort]').forEach((btn) => {
      btn.addEventListener('click', () => {
        btns.forEach((x) => x.classList.toggle('mini-btn--accent', x === btn));
        playSort(btn.dataset.h24Sort || 'quick');
      });
    });

    const shufBtn = h.querySelector('[data-h24-shuffle]');
    shufBtn?.addEventListener('click', () => {
      currentRunId++;
      clearHighlights();
      btns.forEach((x) => x.classList.toggle('mini-btn--accent', x === shufBtn));
      cols.forEach((_, idx) => {
        setColValue(idx, Math.floor(14 + Math.random() * 84));
      });
      if (cmpBadge) cmpBadge.textContent = 'COMPARACIONES: 0';
      if (swpBadge) swpBadge.textContent = 'INTERCAMBIOS: 0';
      animate(cols, { scaleY: [0.4, 1], delay: stagger(18), duration: 320, ease: 'outBack' });
      if (status) status.textContent = 'ARREGLO DE 28 BARRAS DESORDENADO · SELECCIONA UN ALGORITMO';
    });
  });

  // H25: Grafo de Red Neuronal Multicapa con Propagación de Sinapsis SVG
  document.querySelectorAll<HTMLElement>('[data-hyb-25]').forEach((h) => {
    const layers = [0, 1, 2, 3].map((i) => h.querySelectorAll<HTMLElement>(`[data-nn-layer="${i}"] [data-nn-node]`));
    const synapses = h.querySelectorAll<SVGLineElement>('[data-nn-syn]');
    const probs = h.querySelectorAll<HTMLElement>('[data-nn-prob]');
    const out = h.querySelector('[data-h25-out]');

    function fireInference() {
      if (synapses.length) {
        animate(svg.createDrawable(synapses), {
          draw: ['0 0', '0 1'],
          duration: 620,
          delay: stagger(28),
          ease: 'outQuart'
        });
      }
      const tl = createTimeline({ defaults: { duration: 320, ease: 'outBack' } });
      layers.forEach((nodes) => {
        tl.add(nodes, { scale: [1, 1.28, 1], backgroundColor: ['var(--cxd-bg-surface)', 'var(--cxd-accent)', 'var(--cxd-bg-surface)'] }, '-=140');
      });
      const p1 = (88 + Math.random() * 11).toFixed(1);
      const p2 = ((100 - Number(p1)) * 0.7).toFixed(1);
      const p3 = (100 - Number(p1) - Number(p2)).toFixed(1);
      if (probs[0]) probs[0].textContent = `${p1}%`;
      if (probs[1]) probs[1].textContent = `${p2}%`;
      if (probs[2]) probs[2].textContent = `${p3}%`;
      if (out) out.textContent = `PREDICCIÓN SOFTMAX: CLASE A (${p1}% CONFIANZA)`;
    }

    h.querySelector('[data-h25-fire]')?.addEventListener('click', () => fireInference());
  });

  // H26: Sistema Solar Animado Completo (Sol + 8 Planetas + Luna + Cinturón de Asteroides + Telemetría)
  document.querySelectorAll<HTMLElement>('[data-hyb-26]').forEach((h) => {
    const carriers = Array.from(h.querySelectorAll<HTMLElement>('[data-h26-carrier]'));
    const moon = h.querySelector<HTMLElement>('[data-h26-moon]');
    const sun = h.querySelector<HTMLElement>('[data-h26-sun]');
    const targetRing = h.querySelector<HTMLElement>('[data-h26-target-ring]');
    const tel = h.querySelector('[data-h26-telemetry]');
    const planetBtns = h.querySelectorAll<HTMLButtonElement>('[data-h26-planet]');
    const speedBtns = h.querySelectorAll<HTMLButtonElement>('[data-h26-speed]');
    let activeAnims: ReturnType<typeof animate>[] = [];

    if (sun) {
      pauseOutsideViewport(h, animate(sun, { scale: [0.95, 1.08, 0.95], duration: 2600, loop: true, ease: 'inOutSine' }));
    }
    if (moon) {
      pauseOutsideViewport(h, animate(moon, { rotate: '1turn', duration: 1600, ease: 'linear', loop: true }));
    }

    function startOrbits(speedMultiplier: number) {
      activeAnims.forEach((a) => a.pause());
      activeAnims = carriers.map((c, idx) => {
        const basePeriod = Number(c.dataset.period || 6000);
        // Ángulo inicial escalonado para distribución armónica
        c.style.transform = `rotate(${idx * 42}deg)`;
        const orbit = animate(c, {
          rotate: [`${idx * 42}deg`, `${idx * 42 + 360}deg`],
          duration: Math.max(450, Math.round(basePeriod / speedMultiplier)),
          ease: 'linear',
          loop: true
        });
        return orbit;
      });
      if (reducedMotion.matches) activeAnims.forEach(a => a.pause());
    }

    startOrbits(1);
    if (!reducedMotion.matches) new IntersectionObserver(entries => { activeAnims.forEach(a => entries[0]?.isIntersecting ? a.play() : a.pause()); }, { rootMargin: '100px' }).observe(h);

    speedBtns.forEach((sb) => {
      sb.addEventListener('click', () => {
        speedBtns.forEach((x) => x.classList.toggle('mini-btn--accent', x === sb));
        const mult = Number(sb.dataset.h26Speed || 1);
        startOrbits(mult);
      });
    });

    planetBtns.forEach((pb) => {
      pb.addEventListener('click', () => {
        planetBtns.forEach((x) => x.classList.toggle('mini-btn--accent', x === pb));
        const r = Number(pb.dataset.r || 72);
        const diameter = r * 2;
        if (targetRing) {
          targetRing.style.width = `${diameter}px`;
          targetRing.style.height = `${diameter}px`;
          animate(targetRing, { scale: [0.9, 1.05, 1], duration: 420, ease: 'outBack' });
        }
        if (tel && pb.dataset.info) {
          tel.textContent = pb.dataset.info;
        }
      });
    });
  });

  // H27: Ciudadela Isométrica 3D de Servidores
  document.querySelectorAll<HTMLElement>('[data-hyb-27]').forEach((h) => {
    const towers = h.querySelectorAll<HTMLElement>('[data-h27-tower]');
    const btns = h.querySelectorAll<HTMLButtonElement>('[data-h27-wave]');

    function waveIso(origin: 'center' | 'first' | number) {
      animate(towers, {
        translateZ: [0, 34, 0],
        scale: [1, 1.12, 1],
        delay: stagger(55, { grid: [4, 4], from: origin }),
        duration: 680,
        ease: 'outBack'
      });
    }

    btns.forEach((b) => {
      b.addEventListener('click', () => {
        btns.forEach((x) => x.classList.toggle('mini-btn--accent', x === b));
        const mode = b.dataset.h27Wave;
        waveIso(mode === 'first' ? 'first' : mode === 'random' ? Math.floor(Math.random() * 16) : 'center');
      });
    });

    towers.forEach((t, idx) => t.addEventListener('click', () => waveIso(idx)));
  });

  // H28: Analizador de Espectro de 28 Bandas + Osciloscopio
  document.querySelectorAll<HTMLElement>('[data-hyb-28]').forEach((h) => {
    const bars = h.querySelectorAll<HTMLElement>('[data-h28-bar]');
    const wave = h.querySelector<SVGPathElement>('[data-h28-wave]');
    const lbl = h.querySelector('[data-h28-label]');
    const btns = h.querySelectorAll<HTMLButtonElement>('[data-h28-mode]');

    function pulseSpectrum(mode: string) {
      bars.forEach((bar, i) => {
        const height =
          mode === 'bass'
            ? Math.max(15, 95 - i * 3)
            : mode === 'vocal'
              ? 25 + Math.sin(i * 0.4) * 55
              : 20 + ((i * 29 + Math.floor(Math.random() * 60)) % 78);
        animate(bar, { height: `${Math.abs(height)}%`, duration: 380, delay: i * 12, ease: 'outBack' });
      });
      if (wave) {
        animate(svg.createDrawable(wave), { draw: ['0 0', '0 1'], duration: 650, ease: 'outExpo' });
      }
    }

    btns.forEach((b) => {
      b.addEventListener('click', () => {
        btns.forEach((x) => x.classList.toggle('mini-btn--accent', x === b));
        const m = b.dataset.h28Mode || 'arp';
        if (lbl) lbl.textContent = `PERFIL ACÚSTICO: ${b.textContent?.trim().toUpperCase()} // 20Hz - 20kHz`;
        pulseSpectrum(m);
      });
    });
  });

  // H29: Diagrama Interactivo de Grafo Git Multirama (main, develop, feat/anime, tags, merges)
  document.querySelectorAll<HTMLElement>('[data-hyb-29]').forEach((h) => {
    const svgEl = h.querySelector<SVGSVGElement>('[data-h29-svg]');
    const baseEdges = h.querySelectorAll<SVGPathElement>('[data-h29-edge]');
    const dynEdges = h.querySelector<SVGGElement>('[data-h29-dynamic-edges]');
    const dynNodes = h.querySelector<SVGGElement>('[data-h29-dynamic-nodes]');
    const headEl = h.querySelector('[data-h29-head]');
    const tagBadge = h.querySelector('[data-h29-tag-badge]');
    const detailEl = h.querySelector('[data-h29-detail]');

    let mainX = 580;
    let featX = 380;
    let commitCount = 9;
    let tagVersion = 2;

    if (baseEdges.length) {
      animate(svg.createDrawable(baseEdges), {
        draw: ['0 0', '0 1'],
        duration: 1100,
        delay: stagger(140),
        ease: 'outQuart'
      });
    }

    function clearHeadMarks() {
      svgEl?.querySelectorAll('.git-svg-node').forEach((n) => n.classList.remove('is-head'));
    }

    function updateHeadSummary(branchName: string) {
      if (headEl) headEl.textContent = `HEAD // ${branchName} (${commitCount} commits · 3 ramas · v4.${tagVersion}.0)`;
    }

    function createSvgCommitNode(x: number, y: number, sha: string, branch: string, msg: string, tagText?: string) {
      if (!dynNodes) return;
      clearHeadMarks();
      const ns = 'http://www.w3.org/2000/svg';
      const g = document.createElementNS(ns, 'g');
      g.setAttribute('class', 'git-svg-node is-head');
      g.setAttribute('data-h29-commit-item', '');
      g.dataset.sha = sha;
      g.dataset.branch = branch;
      g.dataset.msg = msg;

      const circle = document.createElementNS(ns, 'circle');
      circle.setAttribute('cx', String(x));
      circle.setAttribute('cy', String(y));
      circle.setAttribute('r', '8.5');
      g.appendChild(circle);

      const txt = document.createElementNS(ns, 'text');
      txt.setAttribute('x', String(x));
      txt.setAttribute('y', String(y === 45 ? 25 : y + 23));
      txt.setAttribute('text-anchor', 'middle');
      txt.setAttribute('class', 'git-sha-txt');
      txt.textContent = sha;
      g.appendChild(txt);

      if (tagText) {
        const rect = document.createElementNS(ns, 'rect');
        rect.setAttribute('x', String(x - 28));
        rect.setAttribute('y', String(y === 45 ? 56 : y - 28));
        rect.setAttribute('width', '56');
        rect.setAttribute('height', '16');
        rect.setAttribute('rx', '3');
        rect.setAttribute('class', 'git-tag-pill');
        g.appendChild(rect);

        const tTxt = document.createElementNS(ns, 'text');
        tTxt.setAttribute('x', String(x));
        tTxt.setAttribute('y', String(y === 45 ? 67 : y - 17));
        tTxt.setAttribute('text-anchor', 'middle');
        tTxt.setAttribute('class', 'git-tag-txt');
        tTxt.textContent = tagText;
        g.appendChild(tTxt);
      }

      dynNodes.appendChild(g);
      animate(circle, { r: [0, 10, 8.5], duration: 420, ease: 'outBack' });
      if (detailEl) detailEl.textContent = `[${sha}] (${branch}) — ${msg}`;
    }

    function drawDynamicEdge(d: string) {
      if (!dynEdges) return;
      const ns = 'http://www.w3.org/2000/svg';
      const path = document.createElementNS(ns, 'path');
      path.setAttribute('d', d);
      dynEdges.appendChild(path);
      animate(svg.createDrawable(path), { draw: ['0 0', '0 1'], duration: 550, ease: 'outExpo' });
    }

    // Inspector de clic en cualquier nodo del diagrama
    svgEl?.addEventListener('click', (e) => {
      const node = (e.target as Element).closest<SVGGElement>('[data-h29-commit-item]');
      if (!node) return;
      clearHeadMarks();
      node.classList.add('is-head');
      const sha = node.dataset.sha || '';
      const br = node.dataset.branch || 'main';
      const msg = node.dataset.msg || '';
      if (detailEl) detailEl.textContent = `[${sha}] (${br}) — ${msg}`;
      const c = node.querySelector('circle');
      if (c) animate(c, { r: [12, 8.5], duration: 320, ease: 'outBack' });
    });

    h.querySelector('[data-h29-commit-main]')?.addEventListener('click', () => {
      const nextX = Math.min(825, mainX + 75);
      if (nextX === mainX) mainX = 520;
      const sha = Math.random().toString(16).slice(2, 9);
      drawDynamicEdge(`M ${mainX},45 L ${nextX},45`);
      mainX = nextX;
      commitCount++;
      createSvgCommitNode(mainX, 45, sha, 'main', 'feat(core): sincronización directa en main');
      updateHeadSummary('main');
    });

    h.querySelector('[data-h29-commit-feat]')?.addEventListener('click', () => {
      const startX = Math.max(featX, mainX - 60);
      const nextX = Math.min(810, startX + 75);
      const sha = Math.random().toString(16).slice(2, 9);
      if (featX === 380) {
        // Nueva bifurcación desde main hacia feat/anime
        drawDynamicEdge(`M ${mainX},45 C ${mainX + 28},45 ${nextX - 28},175 ${nextX},175`);
      } else {
        drawDynamicEdge(`M ${featX},175 L ${nextX},175`);
      }
      featX = nextX;
      commitCount++;
      createSvgCommitNode(featX, 175, sha, 'feat/anime', 'feat(anime): nueva curva cinética SVG');
      updateHeadSummary('feat/anime');
    });

    h.querySelector('[data-h29-merge]')?.addEventListener('click', () => {
      const mergeX = Math.min(830, Math.max(mainX, featX) + 70);
      const sha = Math.random().toString(16).slice(2, 9);
      drawDynamicEdge(`M ${mainX},45 L ${mergeX},45`);
      drawDynamicEdge(`M ${featX},175 C ${featX + 30},175 ${mergeX - 30},45 ${mergeX},45`);
      mainX = mergeX;
      commitCount++;
      createSvgCommitNode(mainX, 45, sha, 'main', 'merge: pull request #42 desde feat/anime');
      updateHeadSummary('main');
    });

    h.querySelector('[data-h29-tag]')?.addEventListener('click', () => {
      tagVersion++;
      const tagStr = `v4.${tagVersion}.0`;
      const sha = Math.random().toString(16).slice(2, 9);
      const nextX = Math.min(830, mainX + 65);
      drawDynamicEdge(`M ${mainX},45 L ${nextX},45`);
      mainX = nextX;
      commitCount++;
      createSvgCommitNode(mainX, 45, sha, 'main', `release: publicación oficial ${tagStr}`, tagStr);
      if (tagBadge) tagBadge.textContent = `TAG: ${tagStr}`;
      updateHeadSummary('main');
    });

    h.querySelector('[data-h29-reset]')?.addEventListener('click', () => {
      if (dynEdges) dynEdges.innerHTML = '';
      if (dynNodes) dynNodes.innerHTML = '';
      mainX = 580;
      featX = 380;
      commitCount = 9;
      tagVersion = 2;
      clearHeadMarks();
      const baseNodes = svgEl?.querySelectorAll('.git-svg-node');
      baseNodes?.[baseNodes.length - 1]?.classList.add('is-head');
      if (tagBadge) tagBadge.textContent = 'TAG: v4.2.0';
      if (detailEl) detailEl.textContent = '[7e3b9c4] (main) — deploy: .vercel/output static build ready';
      updateHeadSummary('main');
      if (baseEdges.length) {
        animate(svg.createDrawable(baseEdges), {
          draw: ['0 0', '0 1'],
          duration: 850,
          delay: stagger(100),
          ease: 'outQuart'
        });
      }
    });
  });

  // H30: Radar Sonar Táctico de 360°
  document.querySelectorAll<HTMLElement>('[data-hyb-30]').forEach((h) => {
    const sweep = h.querySelector<HTMLElement>('[data-h30-sweep]');
    const blips = h.querySelectorAll<HTMLElement>('[data-h30-blip]');
    const status = h.querySelector('[data-h30-status]');

    if (sweep) {
      pauseOutsideViewport(h, animate(sweep, { rotate: '1turn', duration: 2800, ease: 'linear', loop: true }));
    }

    h.querySelector('[data-h30-scan]')?.addEventListener('click', () => {
      animate(blips, { scale: [0.4, 1.6, 1], opacity: [0.2, 1], delay: stagger(120), duration: 500, ease: 'outBack' });
      if (status) status.textContent = 'SONAR ACTIVO // 3 CONTACTOS DETECTADOS CON PRECISIÓN';
    });

    h.querySelector('[data-h30-intercept]')?.addEventListener('click', () => {
      animate(blips, { scale: [1, 2.2, 0], opacity: [1, 0], delay: stagger(100), duration: 460, ease: 'outExpo' });
      if (status) status.textContent = 'AMENAZAS NEUTRALIZADAS · ESPACIO DESPEJADO';
    });
  });

  // 7. Selector Desplegable Exclusivo para el Código de cada Framework
  document.querySelectorAll<HTMLElement>('[data-variant-card]').forEach((card) => {
    const fwSelect = card.querySelector<HTMLSelectElement>('[data-unit-fw-select]');
    const panels = card.querySelectorAll<HTMLElement>('[data-fw-panel]');
    const pathEl = card.querySelector<HTMLElement>('[data-unit-path]');
    const cpEl = card.querySelector<HTMLElement>('[data-unit-cp]');
    const toggleBtn = card.querySelector<HTMLButtonElement>('[data-toggle-code]');
    const drawer = card.querySelector<HTMLElement>('[data-code-drawer]');
    const copyBtn = card.querySelector<HTMLButtonElement>('[data-copy-unit-code]');
    const copyLabel = card.querySelector<HTMLElement>('[data-copy-label]');

    fwSelect?.addEventListener('change', () => {
      const fwId = fwSelect.value;
      panels.forEach((p) => {
        const active = p.dataset.fwPanel === fwId;
        p.classList.toggle('is-active', active);
        if (active && p.dataset.filePath) {
          if (pathEl) pathEl.textContent = p.dataset.filePath;
          if (cpEl) cpEl.textContent = `cp ${p.dataset.filePath} ./tu-proyecto/`;
        }
      });
    });

    toggleBtn?.addEventListener('click', () => {
      drawer?.classList.toggle('is-collapsed');
      toggleBtn.setAttribute('aria-expanded', String(!drawer?.classList.contains('is-collapsed')));
    });

    copyBtn?.addEventListener('click', async () => {
      const activeCode = card.querySelector('.unit-code-block.is-active code');
      if (!activeCode) return;
      try { await navigator.clipboard.writeText(activeCode.textContent || ''); } catch { if (copyLabel) copyLabel.textContent = 'No se pudo copiar'; return; }
      if (copyLabel) {
        const prev = copyLabel.textContent;
        copyLabel.textContent = '¡Código Copiado!';
        setTimeout(() => {
          copyLabel.textContent = prev;
        }, 1400);
      }
    });
  });
</script>

