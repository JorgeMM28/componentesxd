  document.querySelectorAll<HTMLElement>('[data-hold-stage]').forEach((st) => {
    const btn = st.querySelector<HTMLElement>('[data-hold-btn]');
    const fill = st.querySelector<HTMLElement>('[data-hold-fill]');
    const label = st.querySelector<HTMLElement>('[data-hold-label]');
    const status = st.querySelector<HTMLElement>('[data-hold-pct]');
    let timer: number | null = null;
    let pct = 0;
    let keyboardArmed = false;

    const startHold = () => {
      if (timer) window.clearInterval(timer);
      pct = 0;
      if (status) status.textContent = 'VERIFICANDO FIRMA...';
      timer = window.setInterval(() => {
        pct = Math.min(100, pct + 8);
        if (fill) fill.style.width = `${pct}%`;
        if (pct >= 100) {
          if (timer) window.clearInterval(timer);
          timer = null;
          if (label) label.textContent = 'PURGA EJECUTADA (100%)';
          if (status) status.textContent = 'CLUSTER PURGADO OK';
          if (btn) animate(btn, { scale: [0.96, 1.04, 1], duration: 340, ease: 'outBack' });
        }
      }, 60);
    };

    const stopHold = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
      if (pct < 100) {
        pct = 0;
        if (fill) fill.style.width = '0%';
        if (status) status.textContent = 'CANCELADO (MANTÉN PRESIONADO)';
      }
    };

    btn?.addEventListener('pointerdown', (event) => { if (event.button === 0) { keyboardArmed = false; startHold(); } });
    btn?.addEventListener('pointerup', stopHold);
    btn?.addEventListener('pointerleave', stopHold);
    btn?.addEventListener('pointercancel', stopHold);
    btn?.addEventListener('blur', () => { keyboardArmed = false; });
    btn?.addEventListener('click', (event) => {
      if (event.detail !== 0) return;
      if (!keyboardArmed) {
        keyboardArmed = true;
        if (status) status.textContent = 'PULSA DE NUEVO PARA CONFIRMAR';
        return;
      }
      keyboardArmed = false;
      pct = 100;
      if (fill) fill.style.width = '100%';
      if (label) label.textContent = 'PURGA CONFIRMADA (100%)';
      if (status) status.textContent = 'CLUSTER PURGADO OK';
    });
  });

