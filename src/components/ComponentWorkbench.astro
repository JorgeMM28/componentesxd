  document.querySelectorAll<HTMLElement>('[data-marquee-carousel]').forEach((mq) => {
    const track = mq.querySelector<HTMLElement>('[data-mq-track]');
    if (!track) return;
    let paused = reducedMotion.matches;
    let visible = false;
    let frame = 0;
    let dir = -1;
    let speed = 1;
    let pos = 0;

    const tick = () => {
      if (!paused) {
        pos += dir * 0.7 * speed;
        if (pos < -260) pos = 0;
        if (pos > 0) pos = -260;
        track.style.transform = `translateX(${pos}px)`;
      }
      if (!paused && visible) frame = requestAnimationFrame(tick);
      else frame = 0;
    };
    const sync = () => { if (!paused && visible && !frame) frame = requestAnimationFrame(tick); };
    new IntersectionObserver(entries => { visible = entries[0]?.isIntersecting || false; sync(); }, { rootMargin: '100px' }).observe(mq);
    mq.querySelector('[data-mq-toggle]')?.addEventListener('click', () => {
      paused = !paused;
      sync();
    });
    mq.querySelector('[data-mq-reverse]')?.addEventListener('click', () => {
      dir *= -1;
    });
    mq.querySelector('[data-mq-fast]')?.addEventListener('click', () => {
      speed = speed === 1 ? 2.4 : 1;
    });
  });

