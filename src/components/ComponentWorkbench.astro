  document.querySelectorAll<HTMLElement>('[data-hyb-01]').forEach((h) => {
    const pills = Array.from(h.querySelectorAll<HTMLButtonElement>('[data-h01-go]'));
    const slides = Array.from(h.querySelectorAll<HTMLElement>('[data-h01-slide]'));
    const bar = h.querySelector<HTMLElement>('[data-h01-bar]');
    const status = h.querySelector('[data-h01-status]');
    let step = 0;

    function goToStep(next: number) {
      step = (next + slides.length) % slides.length;
      pills.forEach((p, i) => p.classList.toggle('is-active', i <= step));
      if (bar) animate(bar, { width: `${((step + 1) / slides.length) * 100}%`, duration: 480, ease: 'outExpo' });
      if (status) status.textContent = `ETAPA 0${step + 1} DE 04 · SINCRONIZADO`;
      slides.forEach((s, i) => {
        const active = i === step;
        s.hidden = !active;
        if (active) {
          animate(s, { x: [36, 0], rotateY: [-12, 0], opacity: [0.3, 1], duration: 420, ease: 'outBack' });
          const chips = s.querySelectorAll('[data-h01-chip]');
          animate(chips, { y: [10, 0], opacity: [0, 1], delay: stagger(70), duration: 300, ease: 'outQuad' });
        }
      });
    }

    pills.forEach((p, i) => p.addEventListener('click', () => goToStep(i)));
    h.querySelector('[data-h01-prev]')?.addEventListener('click', () => goToStep(step - 1));
    h.querySelector('[data-h01-next]')?.addEventListener('click', () => goToStep(step + 1));
  });

