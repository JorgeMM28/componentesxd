    const counter = pk.querySelector('[data-peek-counter]');
    const bar = pk.querySelector<HTMLElement>('[data-peek-bar]');
    let idx = 0;

    function updatePeek(next: number, direction: number) {
      idx = (next + cards.length) % cards.length;
      if (track && cards.length > 1) {
        if (direction > 0) {
          const first = track.firstElementChild;
          if (first) track.appendChild(first);
        } else {
          const last = track.lastElementChild;
          if (last) track.prepend(last);
        }
      }
      if (counter) counter.textContent = `DIAPOSITIVA 0${idx + 1} / 0${cards.length}`;
      if (bar) bar.style.width = `${((idx + 1) / cards.length) * 100}%`;
      animate(cards, {
        x: [direction * 18, 0],
        scale: [0.95, 1],
        opacity: [0.6, 1],
        delay: stagger(45),
        duration: 320,
        ease: 'outBack'
      });
    }

    pk.querySelector('[data-peek-prev]')?.addEventListener('click', () => updatePeek(idx - 1, -1));
