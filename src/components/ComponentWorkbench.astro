    const regSel = h.querySelector<HTMLSelectElement>('[data-h02-region]');
    const costInp = h.querySelector<HTMLInputElement>('[data-h02-cost]');
    const tbody = h.querySelector<HTMLElement>('[data-h02-tbody]');
    const totalEl = h.querySelector('[data-h02-total]');
    let currentTotal = 400;

    function recalcAnimated() {
      let targetSum = 0;
      tbody?.querySelectorAll<HTMLElement>('[data-h02-row]').forEach((r) => {
        targetSum += Number(r.dataset.cost || 0);
      });
      const state = { v: currentTotal };
      currentTotal = targetSum;
      animate(state, {
        v: targetSum,
        duration: 550,
        ease: 'outExpo',
        onUpdate: () => {
          if (totalEl) totalEl.textContent = `$${state.v.toFixed(2)}`;
        }
      });
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!tbody || !nameInp || !regSel || !costInp) return;
      const cost = Number(costInp.value || 100);
      const tr = document.createElement('tr');
      tr.setAttribute('data-h02-row', '');
      tr.dataset.cost = String(cost);
      tr.innerHTML = `
        <td><strong>${nameInp.value}</strong></td>
        <td class="mono">${regSel.value}</td>
        <td class="mono">$${cost.toFixed(2)}</td>
        <td style="text-align:right"><button type="button" class="mini-btn mini-btn--danger" data-h02-del>Eliminar</button></td>
      `;
      tbody.prepend(tr);
      animate(tr, { y: [-18, 0], scale: [0.95, 1], opacity: [0, 1], ease: createSpring({ mass: 1, stiffness: 140, damping: 10 }) });
      recalcAnimated();
    });

    tbody?.addEventListener('click', (e) => {
      const del = (e.target as HTMLElement).closest('[data-h02-del]');
      if (!del) return;
      const tr = del.closest<HTMLElement>('tr');
      if (!tr) return;
      animate(tr, {
        x: [0, 45],
        opacity: [1, 0],
        duration: 240,
        ease: 'inQuad',
        onComplete: () => {
          tr.remove();
          recalcAnimated();
        }
      });
    });
  });

