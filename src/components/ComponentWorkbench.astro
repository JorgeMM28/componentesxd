          rotateY: offset * -14,
          opacity: active ? 1 : 0.5,
          duration: 380,
          ease: 'outBack'
        });
      });
      dots.forEach((d, i) => d.classList.toggle('is-active', i === cur));
    }

    cf.querySelector('[data-cf-prev]')?.addEventListener('click', () => syncCoverflow(cur - 1));
    cf.querySelector('[data-cf-next]')?.addEventListener('click', () => syncCoverflow(cur + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => syncCoverflow(i)));
