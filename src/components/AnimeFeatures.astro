<section class="advanced-anime" aria-labelledby="advanced-title">
  <header><span>ANIME.JS 4.5 / CAPACIDADES ADICIONALES</span><h2 id="advanced-title">Interacción, distribución y navegador.</h2><p>Ejemplos prácticos de APIs de Anime.js para construir interfaces que responden a las personas.</p></header>
  <div class="advanced-grid">
    <article><h3>Distribución animada</h3><p>Alterna entre cuadrícula y lista con <code>createLayout()</code>.</p><div class="layout-demo" data-layout-demo><div>Diseño</div><div>Código</div><div>Entrega</div><div>Medición</div></div><button type="button" data-layout-toggle>Alternar distribución</button><details><summary>Ver código</summary><pre><code>import &#123; createLayout &#125; from 'animejs';
const root = document.querySelector('.layout-demo');
const layout = createLayout(root);
document.querySelector('button').addEventListener('click', () =&gt; &#123;
  layout.update((&#123; root &#125;) =&gt; root.classList.toggle('is-list'));
&#125;);</code></pre></details></article>
    <article><h3>Movimiento arrastrable</h3><p>Arrastra la pieza o usa los botones para moverla con teclado.</p><div class="drag-demo" data-drag-area><div class="drag-piece" data-drag-piece>Mover</div></div><div class="advanced-actions"><button type="button" data-drag-left>← Izquierda</button><button type="button" data-drag-right>Derecha →</button><button type="button" data-drag-reset>Restablecer</button></div><details><summary>Ver código</summary><pre><code>import &#123; createDraggable &#125; from 'animejs';
const piece = document.querySelector('.drag-piece');
const draggable = createDraggable(piece, &#123; container: '.drag-demo' &#125;);
// En una aplicación, conserva una alternativa accesible por teclado.</code></pre></details></article>
    <article><h3>Entrada al desplazar</h3><p>Desplázate dentro del panel para activar una animación con <code>onScroll()</code>.</p><div class="scroll-demo" data-scroll-container tabindex="0" aria-label="Panel desplazable de demostración"><div class="scroll-spacer">Desplázate ↓</div><div class="scroll-piece" data-scroll-piece>Contenido revelado</div><div class="scroll-spacer">Fin del panel</div></div><details><summary>Ver código</summary><pre><code>import &#123; animate, onScroll &#125; from 'animejs';
const container = document.querySelector('.scroll-demo');
const target = document.querySelector('.scroll-piece');
animate(target, &#123; opacity: [0, 1], y: [30, 0],
  duration: 700, autoplay: onScroll(&#123; container, target &#125;)
&#125;);</code></pre></details></article>
    <article><h3>Animación con WAAPI</h3><p>Usa el motor nativo del navegador para animar propiedades compatibles.</p><div class="waapi-demo"><div class="waapi-piece" data-waapi-piece>WAAPI</div></div><button type="button" data-waapi-play>Ejecutar transición</button><details><summary>Ver código</summary><pre><code>import &#123; waapi &#125; from 'animejs';
const piece = document.querySelector('.waapi-piece');
waapi.animate(piece, &#123;
  x: [0, 100, 0], rotate: [0, 180, 360],
  duration: 1400, ease: 'inOutSine'
&#125;);</code></pre></details></article>
  </div>
</section>
<script>
import { animate, onScroll, createLayout, createDraggable, waapi } from 'animejs';
const root = document.querySelector<HTMLElement>('[data-layout-demo]');
if (root) {
  const layout = createLayout(root);
  document.querySelector('[data-layout-toggle]')?.addEventListener('click', () => layout.update(({ root }) => root.classList.toggle('is-list')));
}
const piece = document.querySelector<HTMLElement>('[data-drag-piece]');
const area = document.querySelector<HTMLElement>('[data-drag-area]');
if (piece && area) {
  const draggable = createDraggable(piece, { container: area });
  const move = (delta: number) => { draggable.x += delta; };
  document.querySelector('[data-drag-left]')?.addEventListener('click', () => move(-24));
  document.querySelector('[data-drag-right]')?.addEventListener('click', () => move(24));
  document.querySelector('[data-drag-reset]')?.addEventListener('click', () => draggable.reset());
}
const scrollContainer = document.querySelector<HTMLElement>('[data-scroll-container]');
const scrollTarget = document.querySelector<HTMLElement>('[data-scroll-piece]');
if (scrollContainer && scrollTarget && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  animate(scrollTarget, { opacity: [0, 1], y: [30, 0], duration: 700, autoplay: onScroll({ container: scrollContainer, target: scrollTarget }) });
}
document.querySelector('[data-waapi-play]')?.addEventListener('click', () => {
  const target = document.querySelector<HTMLElement>('[data-waapi-piece]');
  if (target) waapi.animate(target, { x: [0, 100, 0], rotate: [0, 180, 360], duration: 1400, ease: 'inOutSine' });
});
</script>
