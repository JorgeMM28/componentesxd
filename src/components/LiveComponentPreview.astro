---
import Icon from './Icon.astro';

interface Props {
  previewType: string;
  variantId: string;
  variantName: string;
  badge: string;
}

const { previewType, variantId, variantName, badge } = Astro.props;
---

<div class="live-preview-host" data-preview-type={previewType} data-variant-id={variantId}>
  {/* ==========================================================================
      CATEGORÍA 01: TABLAS DE DATOS (10 VARIANTES RADICALMENTE DIFERENTES)
      ========================================================================== */}

  {/* 1. TABLA MODERNA BORDES REDONDEADOS */}
  {previewType === 'table-modern-rounded' && (
    <div class="tbl-modern-rounded">
      <table class="tbl-modern-rounded__table">
        <thead>
          <tr>
            <th>Miembro del Equipo</th>
            <th>Departamento</th>
            <th>Estado</th>
            <th>Rendimiento</th>
            <th style="text-align:right"> Presupuesto</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <div class="user-pill-cell">
                <span class="avatar-circle">AL</span>
                <div><strong>Elena Rostova</strong><small>elena@studio.io</small></div>
              </div>
            </td>
            <td><span class="soft-tag">Arquitectura UI</span></td>
            <td><span class="pill-status pill-status--ok">En Línea</span></td>
            <td><div class="rounded-bar"><span style="width:92%"></span></div></td>
            <td style="text-align:right; font-weight:700;">$14,800</td>
          </tr>
          <tr>
            <td>
              <div class="user-pill-cell">
                <span class="avatar-circle avatar-circle--alt">MK</span>
                <div><strong>Marco Kovacs</strong><small>marco@studio.io</small></div>
              </div>
            </td>
            <td><span class="soft-tag">Core Infraestructura</span></td>
            <td><span class="pill-status pill-status--warn">En Revisión</span></td>
            <td><div class="rounded-bar"><span style="width:68%"></span></div></td>
            <td style="text-align:right; font-weight:700;">$9,450</td>
          </tr>
          <tr>
            <td>
              <div class="user-pill-cell">
                <span class="avatar-circle">SV</span>
                <div><strong>Sofía Vance</strong><small>sofia@studio.io</small></div>
              </div>
            </td>
            <td><span class="soft-tag">Sistemas IA</span></td>
            <td><span class="pill-status pill-status--ok">En Línea</span></td>
            <td><div class="rounded-bar"><span style="width:96%"></span></div></td>
            <td style="text-align:right; font-weight:700;">$19,200</td>
          </tr>
        </tbody>
      </table>
    </div>
  )}

  {/* 2. TABLA STYLELESS (SIN BORDES NI CAJA EXTERIOR) */}
  {previewType === 'table-styleless' && (
    <div class="tbl-styleless-wrap">
      <table class="tbl-styleless">
        <thead>
          <tr>
            <th>01 / Publicación</th>
            <th>02 / Autoría</th>
            <th>03 / Categoría</th>
            <th style="text-align:right">04 / Lecturas</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="styleless-title">Sistemas Reticulares en Interfaces Contemporáneas</td>
            <td>J. Müller-Brockmann</td>
            <td>Tipografía & Layout</td>
            <td style="text-align:right" class="mono">142,890</td>
          </tr>
          <tr>
            <td class="styleless-title">Física de Resortes y Movimiento Determinista en la Web</td>
            <td>R. Freiberg</td>
            <td>Ingeniería Cinética</td>
            <td style="text-align:right" class="mono">98,410</td>
          </tr>
          <tr>
            <td class="styleless-title">Arquitectura de Contenedores Multi-Etapa sin Root</td>
            <td>K. Hightower</td>
            <td>Infraestructura Cloud</td>
            <td style="text-align:right" class="mono">64,120</td>
          </tr>
        </tbody>
      </table>
    </div>
  )}

  {/* 3. TABLA CONTENT-FIT (AJUSTADA EXACTAMENTE AL CONTENIDO) */}
  {previewType === 'table-content-fit' && (
    <div class="tbl-content-fit-outer">
      <span class="fit-helper-note">Ancho automático ajustado al texto (width: max-content):</span>
      <table class="tbl-content-fit">
        <thead>
          <tr>
            <th>COD</th>
            <th>REGIÓN</th>
            <th>PING</th>
            <th>UPTIME</th>
            <th>ESTADO</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>IAD-01</td>
            <td>Virginia</td>
            <td>8.2ms</td>
            <td>99.99%</td>
            <td><span class="dot-ok"></span>OK</td>
          </tr>
          <tr>
            <td>FRA-04</td>
            <td>Frankfurt</td>
            <td>14.7ms</td>
            <td>99.98%</td>
            <td><span class="dot-ok"></span>OK</td>
          </tr>
          <tr>
            <td>NRT-02</td>
            <td>Tokyo</td>
            <td>41.1ms</td>
            <td>99.95%</td>
            <td><span class="dot-warn"></span>WARN</td>
          </tr>
        </tbody>
      </table>
    </div>
  )}

  {/* 4. TABLA DE FILAS FLOTANTES SEPARADAS */}
  {previewType === 'table-floating' && (
    <div class="tbl-floating-wrap">
      <table class="tbl-floating">
        <thead>
          <tr>
            <th>Servidor / Nodo</th>
            <th>Dirección IP</th>
            <th>Carga GPU</th>
            <th>Estado Operativo</th>
            <th style="text-align:right">Latencia</th>
          </tr>
        </thead>
        <tbody>
          <tr class="floating-row">
            <td><strong>tensor-node-alpha-01</strong></td>
            <td class="mono">10.240.12.88</td>
            <td class="mono">78.4% (H100)</td>
            <td><span class="cxd-badge cxd-badge--active">OPERATIONAL</span></td>
            <td style="text-align:right" class="mono">4.2ms</td>
          </tr>
          <tr class="floating-row">
            <td><strong>tensor-node-beta-02</strong></td>
            <td class="mono">10.240.12.89</td>
            <td class="mono">91.0% (H100)</td>
            <td><span class="cxd-badge cxd-badge--active">OPERATIONAL</span></td>
            <td style="text-align:right" class="mono">5.8ms</td>
          </tr>
          <tr class="floating-row">
            <td><strong>storage-cold-replica-09</strong></td>
            <td class="mono">10.240.99.14</td>
            <td class="mono">12.1% (NVMe)</td>
            <td><span class="cxd-badge cxd-badge--pending">SYNCING</span></td>
            <td style="text-align:right" class="mono">19.4ms</td>
          </tr>
        </tbody>
      </table>
    </div>
  )}

  {/* 5. TABLA INTERACTIVA (ORDENAMIENTO EN VIVO + SELECCIÓN MÚLTIPLE) */}
  {previewType === 'table-interactive' && (
    <div class="cxd-table-shell" data-interactive-table>
      <div class="cxd-table-toolbar">
        <span class="mono" data-sel-counter>0 filas seleccionadas (Haz clic en cabeceras para ordenar)</span>
        <button type="button" class="mini-btn" data-clear-sel>Limpiar Selección</button>
      </div>
      <table class="cxd-table">
        <thead>
          <tr>
            <th style="width:42px"><input type="checkbox" data-check-all /></th>
            <th class="is-sortable" data-sort-col="0">Servicio (Click Ordenar)</th>
            <th class="is-sortable" data-sort-col="1">Peticiones/s (Click Ordenar)</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><input type="checkbox" data-row-check /></td>
            <td data-val="Auth Gateway"><strong>Auth Gateway</strong></td>
            <td data-val="42500" class="mono">42,500 req/s</td>
            <td><span class="cxd-badge cxd-badge--active">ACTIVE</span></td>
          </tr>
          <tr>
            <td><input type="checkbox" data-row-check /></td>
            <td data-val="Billing Engine"><strong>Billing Engine</strong></td>
            <td data-val="12800" class="mono">12,800 req/s</td>
            <td><span class="cxd-badge cxd-badge--active">ACTIVE</span></td>
          </tr>
          <tr>
            <td><input type="checkbox" data-row-check /></td>
            <td data-val="Search Indexer"><strong>Search Indexer</strong></td>
            <td data-val="89400" class="mono">89,400 req/s</td>
            <td><span class="cxd-badge cxd-badge--pending">INDEXING</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  )}

  {/* 6. TABLA CON ACCIONES CRUD EN VIVO */}
  {previewType === 'table-actions' && (
    <div class="cxd-table-shell" data-crud-table>
      <div class="cxd-table-toolbar">
        <span class="mono">Prueba los botones de acción a la derecha de cada fila:</span>
        <button type="button" class="mini-btn mini-btn--accent" data-add-crud-row>+ Agregar Nueva Fila</button>
      </div>
      <table class="cxd-table">
        <thead>
          <tr>
            <th>Recurso / Endpoint</th>
            <th>Ambiente</th>
            <th>Estado</th>
            <th style="text-align:right">Acciones Rápidas</th>
          </tr>
        </thead>
        <tbody data-crud-tbody>
          <tr>
            <td><strong>/api/v2/payments/webhook</strong></td>
            <td class="mono">production</td>
            <td><span class="cxd-badge cxd-badge--active" data-status-pill>ACTIVE</span></td>
            <td style="text-align:right">
              <div class="row-actions">
                <button type="button" class="mini-btn" data-row-toggle>Alternar Estado</button>
                <button type="button" class="mini-btn" data-row-dup>Duplicar</button>
                <button type="button" class="mini-btn mini-btn--danger" data-row-del>Eliminar</button>
              </div>
            </td>
          </tr>
          <tr>
            <td><strong>/api/v2/users/export-csv</strong></td>
            <td class="mono">staging</td>
            <td><span class="cxd-badge cxd-badge--pending" data-status-pill>PAUSED</span></td>
            <td style="text-align:right">
              <div class="row-actions">
                <button type="button" class="mini-btn" data-row-toggle>Alternar Estado</button>
                <button type="button" class="mini-btn" data-row-dup>Duplicar</button>
                <button type="button" class="mini-btn mini-btn--danger" data-row-del>Eliminar</button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  )}

  {/* 7. TABLA CON FORMULARIO INTEGRADO Y CÁLCULO EN VIVO */}
  {previewType === 'table-form' && (
    <div class="cxd-table-shell" data-form-table>
      <table class="cxd-table">
        <thead>
          <tr>
            <th>Concepto / Servidor (Editable)</th>
            <th>Plan (Select)</th>
            <th>Cantidad (Input)</th>
            <th>Precio Unitario</th>
            <th style="text-align:right">Subtotal</th>
          </tr>
        </thead>
        <tbody>
          <tr data-calc-row>
            <td><input type="text" value="Instancia GPU A100" class="tbl-input" /></td>
            <td>
              <select class="tbl-select" data-row-price>
                <option value="120">Dedicated ($120)</option>
                <option value="65">Spot ($65)</option>
              </select>
            </td>
            <td><input type="number" value="3" min="1" max="50" class="tbl-input tbl-input--num" data-row-qty /></td>
            <td class="mono" data-unit-display>$120.00</td>
            <td style="text-align:right; font-weight:700;" class="mono" data-row-subtotal>$360.00</td>
          </tr>
          <tr data-calc-row>
            <td><input type="text" value="Bloque NVMe Replica" class="tbl-input" /></td>
            <td>
              <select class="tbl-select" data-row-price>
                <option value="45">High-IOPS ($45)</option>
                <option value="20">Standard ($20)</option>
              </select>
            </td>
            <td><input type="number" value="4" min="1" max="50" class="tbl-input tbl-input--num" data-row-qty /></td>
            <td class="mono" data-unit-display>$45.00</td>
            <td style="text-align:right; font-weight:700;" class="mono" data-row-subtotal>$180.00</td>
          </tr>
        </tbody>
        <tfoot>
          <tr style="background:var(--cxd-bg-elevated)">
            <td colspan="4" style="text-align:right; font-weight:700;">TOTAL MENSUAL ESTIMADO (Edita cantidades o planes arriba):</td>
            <td style="text-align:right; font-weight:800; color:var(--cxd-accent);" class="mono" data-table-grand-total>$540.00</td>
          </tr>
        </tfoot>
      </table>
    </div>
  )}

  {/* 8. TABLA CON FILTROS COMBINADOS EN VIVO */}
  {previewType === 'table-filters' && (
    <div class="cxd-table-shell" data-multi-filter-table>
      <div class="cxd-table-toolbar">
        <input type="search" class="tbl-input" style="max-width:240px" placeholder="Buscar por nombre..." data-mf-search />
        <select class="tbl-select" data-mf-role>
          <option value="all">Todas las Áreas</option>
          <option value="Frontend">Área: Frontend</option>
          <option value="Backend">Área: Backend</option>
          <option value="DevOps">Área: DevOps</option>
        </select>
        <div class="cxd-table-filter-group">
          <button type="button" class="cxd-table-filter-btn is-active" data-mf-status="all">Todos</button>
          <button type="button" class="cxd-table-filter-btn" data-mf-status="online">Online</button>
          <button type="button" class="cxd-table-filter-btn" data-mf-status="busy">Busy</button>
        </div>
      </div>
      <table class="cxd-table">
        <thead>
          <tr><th>Ingeniero</th><th>Área</th><th>Estado</th><th>Commits Mes</th></tr>
        </thead>
        <tbody>
          <tr data-role="Frontend" data-status="online"><td><strong>Lucas Meyer</strong></td><td>Frontend</td><td><span class="cxd-badge cxd-badge--active">online</span></td><td class="mono">148</td></tr>
          <tr data-role="Backend" data-status="busy"><td><strong>Daria Novak</strong></td><td>Backend</td><td><span class="cxd-badge cxd-badge--pending">busy</span></td><td class="mono">219</td></tr>
          <tr data-role="DevOps" data-status="online"><td><strong>Kenji Sato</strong></td><td>DevOps</td><td><span class="cxd-badge cxd-badge--active">online</span></td><td class="mono">94</td></tr>
          <tr data-role="Frontend" data-status="busy"><td><strong>Clara Lindqvist</strong></td><td>Frontend</td><td><span class="cxd-badge cxd-badge--pending">busy</span></td><td class="mono">176</td></tr>
        </tbody>
      </table>
    </div>
  )}

  {/* 9. TABLA EXPANDIBLE MASTER-DETAIL */}
  {previewType === 'table-expandable' && (
    <div class="cxd-table-shell">
      <table class="cxd-table">
        <thead>
          <tr><th>Incidente / Despliegue (Haz clic en la fila para expandir detalles)</th><th>Severidad</th><th>Duración</th></tr>
        </thead>
        <tbody>
          <tr class="expand-trigger-row" onclick="const n=this.nextElementSibling; n.style.display=n.style.display==='none'?'table-row':'none'">
            <td><Icon name="chevron-down" size={14} /> <strong>INC-4091 — Latencia elevada en balanceador US-East</strong></td>
            <td><span class="cxd-badge cxd-badge--pending">SEV-2</span></td>
            <td class="mono">14m 22s</td>
          </tr>
          <tr class="expand-detail-row">
            <td colspan="3">
              <div class="expanded-panel-box">
                <strong>Diagnóstico Técnico Desplegado:</strong>
                <p>Rebalanceo automático ejecutado hacia el pool de respaldo <code>us-east-1b</code>. Tráfico normalizado al 100%.</p>
              </div>
            </td>
          </tr>
          <tr class="expand-trigger-row" onclick="const n=this.nextElementSibling; n.style.display=n.style.display==='none'?'table-row':'none'">
            <td><Icon name="chevron-down" size={14} /> <strong>DEP-8820 — Actualización de Kernel en Nodos Worker</strong></td>
            <td><span class="cxd-badge cxd-badge--active">COMPLETED</span></td>
            <td class="mono">04m 10s</td>
          </tr>
          <tr class="expand-detail-row" style="display:none">
            <td colspan="3">
              <div class="expanded-panel-box">
                <strong>Resumen de Nodos:</strong>
                <p>24 de 24 contenedores reiniciados con cero pérdida de paquetes.</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  )}

  {/* 10. TABLA INDUSTRIAL CEBRA CON PIE DE SUMATORIA */}
  {previewType === 'table-ledger-striped' && (
    <div class="tbl-brutalist-zebra-wrap">
      <table class="tbl-brutalist-zebra">
        <thead>
          <tr><th>LOTE #</th><th>OPERACIÓN</th><th>CUENTA</th><th style="text-align:right">IMPORTE NETO</th></tr>
        </thead>
        <tbody>
          <tr><td>#001</td><td>LIQUIDACIÓN INTERBANCARIA</td><td>CH-9941-ZUR</td><td style="text-align:right">$420,000.00</td></tr>
          <tr><td>#002</td><td>COBERTURA DIVISAS EUR/USD</td><td>DE-4410-FRA</td><td style="text-align:right">$185,500.00</td></tr>
          <tr><td>#003</td><td>CUSTODIA BONOS TESORO</td><td>US-1102-NYC</td><td style="text-align:right">$910,250.00</td></tr>
        </tbody>
        <tfoot>
          <tr><td colspan="3">BALANCE CONSOLIDADO VERIFICADO</td><td style="text-align:right">$1,515,750.00</td></tr>
        </tfoot>
      </table>
    </div>
  )}

  {/* ==========================================================================
      CATEGORÍA 02: TOASTERS Y NOTIFICACIONES (8 VARIANTES DISTINTAS)
      ========================================================================== */}
  {previewType === 'toast-modern' && (
    <div class="stage-center">
      <div class="toast-modern-box" data-modern-toast>
        <div class="toast-modern-box__row">
          <span class="toast-icon-circle"><Icon name="check" size={15} /></span>
          <div style="flex:1">
            <strong>Copia de seguridad completada con éxito</strong>
            <p>14.2 GB sincronizados en el almacenamiento encriptado.</p>
          </div>
          <button type="button" class="mini-btn" data-replay-toast-bar>Reiniciar Barra</button>
        </div>
        <div class="toast-timer-bar"><span data-toast-fill></span></div>
      </div>
    </div>
  )}

  {previewType === 'toast-island' && (
    <div class="stage-center">
      <div class="island-morph-shell" data-island-shell>
        <div class="island-top-row">
          <span class="cxd-dynamic-island__dot"></span>
          <strong class="mono" data-island-state-title>MODO COMPACTO // IDLE</strong>
          <div class="row-actions">
            <button type="button" class="mini-btn" data-island-mode="compact">Compacto</button>
            <button type="button" class="mini-btn" data-island-mode="expanded">Expandir Detalles</button>
          </div>
        </div>
        <div class="island-extra-body" data-island-body hidden>
          <p>Despliegue en curso hacia 12 regiones de borde · 94% completado · 0 errores reportados.</p>
        </div>
      </div>
    </div>
  )}

  {previewType === 'toast-actions' && (
    <div class="stage-center">
      <div class="cxd-toast-card" style="width:100%; max-width:520px; align-items:center;">
        <div>
          <strong>Solicitud de fusión en rama principal (#409)</strong>
          <p class="sub-p" data-action-toast-msg>¿Deseas aprobar y desplegar los cambios ahora mismo?</p>
        </div>
        <div class="row-actions">
          <button type="button" class="mini-btn mini-btn--accent" onclick="this.closest('.cxd-toast-card').querySelector('[data-action-toast-msg]').textContent='Estado: Aprobado y desplegado en producción.'">Aprobar</button>
          <button type="button" class="mini-btn" onclick="this.closest('.cxd-toast-card').querySelector('[data-action-toast-msg]').textContent='Estado: Pospuesto por 1 hora.'">Posponer</button>
        </div>
      </div>
    </div>
  )}

  {previewType === 'toast-form' && (
    <div class="stage-center">
      <div class="cxd-toast-card" style="width:100%; max-width:520px; flex-direction:column;">
        <div style="display:flex; justify-content:space-between; width:100%;">
          <strong>Comentario de Revisión — @sofia_vance</strong>
          <span class="mono" style="font-size:0.7rem">hace 1 min</span>
        </div>
        <p class="sub-p">"¿Podemos subir el límite de rate-limiting a 5,000 req/min?"</p>
        <form class="toast-inline-form" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Respuesta Enviada'">
          <input type="text" class="tbl-input" placeholder="Escribe una respuesta rápida..." required />
          <button type="submit" class="mini-btn mini-btn--accent">Responder</button>
        </form>
      </div>
    </div>
  )}

  {previewType === 'toast-spawner' && (
    <div class="stage-center" style="flex-direction:column; gap:1rem;" data-toast-spawner>
      <div class="row-actions">
        <button type="button" class="mini-btn mini-btn--accent" data-spawn-type="ok">+ Disparar Toast Éxito</button>
        <button type="button" class="mini-btn" data-spawn-type="warn">+ Disparar Toast Alerta</button>
        <button type="button" class="mini-btn mini-btn--danger" data-spawn-type="err">+ Disparar Toast Error</button>
      </div>
      <div class="spawned-toast-list" data-spawn-list>
        <div class="cxd-toast-card">
          <span>Notificación activa en cola (Haz clic arriba para apilar más)</span>
          <span class="cxd-badge cxd-badge--active">READY</span>
        </div>
      </div>
    </div>
  )}

  {previewType === 'toast-styleless' && (
    <div class="stage-center">
      <div class="toast-styleless-line">
        <span class="mono">AVISO DEL SISTEMA // 23:40 UTC</span>
        <p>La ventana de mantenimiento programado iniciará en 15 minutos sin interrupción de tráfico activo.</p>
      </div>
    </div>
  )}

  {previewType === 'toast-pill' && (
    <div class="stage-center">
      <div class="toast-pill-fit">
        <span class="cxd-badge cxd-badge--active">NUEVO</span>
        <span>Motor Anime.js v4 integrado en todas las rutas</span>
        <button type="button" class="mini-btn" onclick="this.textContent='Verificado'">Entendido</button>
      </div>
    </div>
  )}

  {previewType === 'toast-upload' && (
    <div class="stage-center">
      <div class="cxd-toast-card" style="width:100%; max-width:460px; flex-direction:column;" data-upload-toast>
        <div style="display:flex; justify-content:space-between; width:100%;">
