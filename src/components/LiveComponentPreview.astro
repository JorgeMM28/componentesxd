    margin-top: 0.65rem;
  }

  .toast-inline-form input {
    flex: 1;
  }

  .spawned-toast-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    max-width: 480px;
  }

  .toast-styleless-line {
    border-left: 2px solid var(--cxd-accent);
    padding-left: 1rem;
    max-width: 520px;
  }

  .toast-pill-fit {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    font-size: 0.82rem;
  }

  /* Botones */
  .btn-pill-modern {
    padding: 0.68rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    border: 1px solid transparent;
    transition: transform 140ms ease;
  }

  .btn-pill-modern:active { transform: scale(0.96); }
  .btn-pill-modern--primary { background: var(--cxd-accent); color: var(--cxd-accent-fg, #000); }
  .btn-pill-modern--soft { background: var(--cxd-bg-elevated); color: var(--cxd-text-primary); }
  .btn-pill-modern--outline { background: transparent; border-color: var(--cxd-border-strong); color: var(--cxd-text-primary); }

  .btn-styleless-minimal {
    background: none;
    border: none;
    border-bottom: 1px solid var(--cxd-text-primary);
    padding: 0.35rem 0;
    color: var(--cxd-text-primary);
    font-size: 0.9rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    text-decoration: none;
  }

  .fab-cluster {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .fab-main-trigger {
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    background: var(--cxd-accent);
    color: var(--cxd-accent-fg, #000);
    border: none;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    box-shadow: var(--cxd-shadow-md);
  }

  .fab-satellites {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-3d-secondary {
    padding: 0.65rem 1.25rem;
    background: var(--cxd-bg-surface);
    color: var(--cxd-text-primary);
    border: 2px solid var(--cxd-text-primary);
    box-shadow: 4px 4px 0 var(--cxd-text-primary);
    font-family: var(--cxd-font-mono);
    font-weight: 700;
    cursor: pointer;
  }

  .btn-3d-secondary:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--cxd-text-primary);
  }

  /* Tarjetas */
  .card-styleless-editorial {
    max-width: 520px;
    border-top: 2px solid var(--cxd-text-primary);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-floating-3d {
    max-width: 440px;
    width: 100%;
    padding: 1.5rem;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    border-radius: 14px;
    box-shadow: var(--cxd-shadow-lg);
    transition: transform 120ms ease;
  }

  .card-tabbed-box, .card-with-actions {
    max-width: 480px;
    width: 100%;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-md);
    padding: 1.15rem;
  }

  .card-tabbed-box__nav {
    display: flex;
    gap: 0.4rem;
    border-bottom: 1px solid var(--cxd-border);
    padding-bottom: 0.65rem;
    margin-bottom: 0.85rem;
  }

  .card-tabbed-box__nav button {
    padding: 0.3rem 0.65rem;
    background: transparent;
    border: 1px solid transparent;
    color: var(--cxd-text-secondary);
    font-family: var(--cxd-font-mono);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .card-tabbed-box__nav button.is-active {
    background: var(--cxd-bg-active);
    color: var(--cxd-text-primary);
    border-color: var(--cxd-border-strong);
  }

  .card-action-footer {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--cxd-border);
  }

  .card-content-fit-kpi {
    width: max-content;
    padding: 0.85rem 1.15rem;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Forms */
  .form-modern-box {
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.82rem;
  }

  .input-modern-rounded {
    padding: 0.7rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--cxd-border-strong);
    background: var(--cxd-bg-surface);
    color: var(--cxd-text-primary);
  }

  .form-styleless-box {
    width: 100%;
    max-width: 440px;
  }

  .input-styleless-line {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 2px solid var(--cxd-text-primary);
    padding: 0.6rem 0;
    color: var(--cxd-text-primary);
    font-size: 1rem;
    outline: none;
  }

  .form-inline-fit {
    width: max-content;
    display: inline-flex;
    align-items: center;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    border-radius: 999px;
    padding: 0.25rem;
  }

  .pwd-bars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin-bottom: 0.35rem;
  }

  .pwd-bars span {
    height: 5px;
    background: var(--cxd-bg-elevated);
  }

  .pwd-bars span.is-on {
    background: var(--cxd-success);
  }

  .switch-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .demo-nav-bar, .docker-topology-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    padding: 0.75rem 1rem;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-md);
  }

  .docker-node {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.8rem;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border);
  }

  .docker-node small {
    display: block;
    font-size: 0.66rem;
    color: var(--cxd-text-muted);
  }

  /* Carruseles & Sliders */
  .carousel-stage {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .coverflow-viewport {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.85rem;
    perspective: 900px;
  }

  .coverflow-slide {
    padding: 1.15rem;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border);
    border-radius: var(--cxd-radius-md);
    opacity: 0.55;
    transform: scale(0.92) rotateY(-8deg);
    transition: all 260ms ease;
  }

  .coverflow-slide.is-active {
    opacity: 1;
    transform: scale(1.02) rotateY(0deg);
    border-color: var(--cxd-accent);
    box-shadow: var(--cxd-shadow-md);
  }

  .coverflow-slide h4 {
    margin: 0.35rem 0;
    font-size: 0.95rem;
  }

  .coverflow-slide p {
    font-size: 0.78rem;
    color: var(--cxd-text-secondary);
  }

  .carousel-controls-row,
  .marquee-toolbar,
  .peek-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .carousel-dots {
    display: flex;
    gap: 0.4rem;
  }

  .c-dot {
    width: 22px;
    height: 6px;
    border-radius: 99px;
    border: none;
    background: var(--cxd-border-strong);
    cursor: pointer;
  }

  .c-dot.is-active {
    background: var(--cxd-accent);
    width: 34px;
  }

  .marquee-window {
    overflow: hidden;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    padding: 0.85rem;
    border-radius: var(--cxd-radius-sm);
  }

  .marquee-track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
  }

  .marquee-chip {
    padding: 0.55rem 0.9rem;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border);
    display: flex;
    flex-direction: column;
    min-width: 150px;
  }

  .marquee-chip span {
    font-family: var(--cxd-font-mono);
    font-size: 0.66rem;
    color: var(--cxd-text-muted);
  }

  .peek-viewport {
    overflow: hidden;
    width: 100%;
  }

  .peek-track {
    display: grid;
    grid-template-columns: repeat(5, minmax(210px, 1fr));
    gap: 0.85rem;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .peek-card {
    padding: 1rem;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-sm);
  }

  .peek-card h5 {
    margin-top: 0.5rem;
    font-size: 0.92rem;
  }

  .v-reel-shell {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 1rem;
    align-items: stretch;
  }

  .v-reel-nav {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .v-reel-btn {
    padding: 0.55rem 0.75rem;
    text-align: left;
    font-family: var(--cxd-font-mono);
    font-size: 0.73rem;
    background: var(--cxd-bg-surface);
    color: var(--cxd-text-secondary);
    border: 1px solid var(--cxd-border);
    cursor: pointer;
  }

  .v-reel-btn.is-active {
    border-color: var(--cxd-accent);
    color: var(--cxd-text-primary);
    background: var(--cxd-bg-active);
  }

  .v-reel-window {
    height: 118px;
    overflow: hidden;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    position: relative;
  }

  .v-reel-slide {
    height: 118px;
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .split-showcase-box {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    border: 1px solid var(--cxd-border-strong);
    background: var(--cxd-bg-surface);
    border-radius: var(--cxd-radius-md);
    overflow: hidden;
  }

  .split-visual-pane {
    padding: 1.5rem;
    background: var(--cxd-bg-elevated);
    border-right: 1px solid var(--cxd-border);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .split-big-metric {
    font-family: var(--cxd-font-mono);
    font-size: 2.3rem;
    font-weight: 800;
    margin-top: 0.75rem;
  }

  .split-info-pane {
    padding: 1.5rem;
  }

  .filmstrip-main {
    padding: 1.35rem;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-sm);
  }

  .filmstrip-thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.5rem;
  }

  .fs-thumb {
    padding: 0.55rem;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border);
    color: var(--cxd-text-secondary);
    font-family: var(--cxd-font-mono);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .fs-thumb.is-active {
    border-color: var(--cxd-accent);
    color: var(--cxd-text-primary);
    font-weight: 700;
  }

  .stories-shell,
  .swipe-deck-box {
    max-width: 520px;
    width: 100%;
    margin: 0 auto;
    padding: 1.15rem;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .stories-bars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .story-seg {
    height: 4px;
    background: var(--cxd-bg-elevated);
    overflow: hidden;
  }

  .story-seg span {
    display: block;
    height: 100%;
    background: var(--cxd-accent);
    transition: width 260ms ease;
  }

  .swipe-card {
    padding: 1.25rem;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-sm);
    text-align: center;
  }

  /* Acordeones, Before/After, Kanban & Pickers */
  .acc-stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .acc-item {
    border: 1px solid var(--cxd-border-strong);
    background: var(--cxd-bg-surface);
    border-radius: var(--cxd-radius-sm);
  }

  .acc-trigger {
    width: 100%;
    padding: 0.85rem 1rem;
    background: transparent;
    border: none;
    color: var(--cxd-text-primary);
    font-weight: 600;
    font-size: 0.86rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    text-align: left;
  }

  .acc-panel {
    padding: 0 1rem 0.9rem;
    border-top: 1px solid var(--cxd-border);
  }

  .ba-comparator {
    position: relative;
    width: 100%;
    max-width: 580px;
    height: 130px;
    border: 1px solid var(--cxd-border-strong);
    overflow: hidden;
    background: var(--cxd-bg-surface);
  }

  .ba-layer {
    position: absolute;
    inset: 0;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ba-layer--before {
    background: var(--cxd-bg-elevated);
    border-right: 2px solid var(--cxd-accent);
    overflow: hidden;
    white-space: nowrap;
  }

  .ba-slider {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
  }

  .kanban-board {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.85rem;
    width: 100%;
  }

  .kanban-col {
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-sm);
    padding: 0.75rem;
  }

  .kanban-col__head {
    display: flex;
    justify-content: space-between;
    font-family: var(--cxd-font-mono);
    font-size: 0.7rem;
    color: var(--cxd-text-muted);
    margin-bottom: 0.65rem;
  }

  .kanban-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .kanban-card {
    padding: 0.65rem;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.78rem;
  }

  .pricing-cards-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.85rem;
    width: 100%;
    max-width: 640px;
  }

  .pricing-mini-card {
    padding: 1rem;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border);
    border-radius: var(--cxd-radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pricing-mini-card--featured {
    border-color: var(--cxd-accent);
  }

  .pricing-val {
    font-family: var(--cxd-font-mono);
    font-size: 1.5rem;
  }

  .pricing-val span {
    font-size: 0.75rem;
    color: var(--cxd-text-muted);
  }

  .filetree-box,
  .transfer-box {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 0.85rem;
    width: 100%;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    padding: 0.9rem;
    border-radius: var(--cxd-radius-sm);
  }

  .filetree-sidebar,
  .transfer-items {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .ft-item,
  .tr-item {
    padding: 0.5rem 0.7rem;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border);
    color: var(--cxd-text-secondary);
    font-family: var(--cxd-font-mono);
    font-size: 0.72rem;
    text-align: left;
    cursor: pointer;
  }

  .ft-item.is-active,
  .tr-item.is-assigned {
    border-color: var(--cxd-accent);
    color: var(--cxd-text-primary);
  }

  .filetree-viewer {
    padding: 0.75rem;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border);
  }

  .scheduler-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-sm);
  }

  .scheduler-days,
  .scheduler-slots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ==========================================================================
     ESTILOS PARA LOS 20 COMPONENTES ESPECIALES HÍBRIDOS (UI + ANIME.JS v4)
     ========================================================================== */
  .hyb-shell {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.15rem;
    background: var(--cxd-bg-surface);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-md);
  }

  .hyb-stepper-head {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .hyb-step-nodes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.45rem;
  }

  .hyb-step-pill {
    padding: 0.5rem 0.75rem;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border);
    color: var(--cxd-text-secondary);
    font-family: var(--cxd-font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    text-align: left;
  }

  .hyb-step-pill.is-active {
    background: var(--cxd-accent);
    color: var(--cxd-accent-fg, #000);
    border-color: var(--cxd-accent);
    font-weight: 700;
  }

  .hyb-slide-card {
    padding: 1.25rem;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-sm);
  }

  .hyb-slide-card h4 {
    margin: 0.45rem 0 0.25rem;
    font-size: 1rem;
  }

  .hyb-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.75rem;
  }

  .hyb-chip {
    padding: 0.3rem 0.65rem;
    background: var(--cxd-bg-elevated);
    border: 1px solid var(--cxd-border-strong);
    font-family: var(--cxd-font-mono);
    font-size: 0.7rem;
    border-radius: var(--cxd-radius-sm);
  }

  .hyb-inline-add-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .hyb-morph-grid,
  .hyb-spring-deck-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    align-items: center;
  }

  .hyb-morph-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border);
    padding: 1rem;
    color: var(--cxd-accent);
  }

  .hyb-svg-canvas {
    width: 180px;
    height: 110px;
  }

  .hyb-deck-stack,
  .hyb-layers-stack {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .hyb-deck-card {
    padding: 0.7rem 0.95rem;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border-strong);
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
  }

  .hyb-otp-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .hyb-node-matrix {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.45rem;
  }

  .hyb-matrix-btn {
    padding: 0.5rem;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border-strong);
    color: var(--cxd-text-primary);
    font-family: var(--cxd-font-mono);
    font-size: 0.7rem;
    cursor: pointer;
  }

  .hyb-console-output {
    padding: 0.85rem 1rem;
