---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import registry from '../data/vaultRegistry.json';
const homeVariantLimit = 5;
---

<Layout title="COMPONENTESXD // Bóveda Multi-Framework & Documentación Interactiva Anime.js v4" section="HOME">
  <!-- HERO ARQUITECTÓNICO CON DEMO EN VIVO DE ANIME.JS v4 -->
  <section class="hero-grid-shell">
    <div class="hero-grid-shell__left">
      <span class="arch-eyebrow">ARCHITECTURAL UI LIBRARY & ANIME.JS v4 ENCYCLOPEDIA</span>
      <h1 class="hero-main-title">
        Componentes con diferencias reales y toda la potencia de Anime.js v4.
      </h1>
      <p class="hero-main-lead">
        Explora desde la <strong>barra superior con menú en cascada (estilo Microsoft)</strong> cada uno
        de los apartados: selecciona <strong>Componentes</strong>, pasa por <strong>Tablas, Toasters, Botones,
        Tarjetas o Formularios</strong> y salta directamente a cualquiera de sus variantes previsualizadas
        en ancho completo, con lista desplegable exclusiva para elegir el código de tu framework.
      </p>

      <div class="hero-cta-row">
        <a href="/components/tables" class="arch-btn arch-btn--primary">
          <Icon name="grid" size={15} />
          <span>Ver las 10 Variantes de Tablas</span>
          <Icon name="arrow-right" size={14} />
        </a>
        <a href="/animations/svg-animations" class="arch-btn">
          <Icon name="activity" size={15} />
          <span>Explorar Animaciones Anime.js v4</span>
        </a>
        <a href="/interfaces" class="arch-btn">
          <Icon name="palette" size={15} />
          <span>Probar las 12 Interfaces</span>
        </a>
      </div>
    </div>

    <!-- DEMO INTERACTIVA ANIME.JS v4 EN LA PORTADA -->
    <div class="hero-grid-shell__right">
      <div class="hero-anime-widget">
        <div class="hero-anime-widget__bar">
          <span class="mono-sm">ANIME.JS v4 LIVE ENGINE // STAGGER + SVG DRAWABLE</span>
          <button type="button" class="mini-replay-btn" id="hero-anime-trigger">
            <Icon name="refresh" size={12} />
            <span>Disparar Onda</span>
          </button>
        </div>

        <div class="hero-anime-stage">
          <svg viewBox="0 0 320 90" class="hero-circuit-svg">
            <path
              id="hero-svg-line"
              d="M 15,70 L 65,20 L 115,70 L 165,15 L 215,70 L 265,25 L 305,50"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
            />
          </svg>
          <div class="hero-stagger-bars" id="hero-stagger-bars">
            {Array.from({ length: 14 }).map(() => (
              <span class="h-bar"></span>
            ))}
          </div>
        </div>

        <div class="hero-stats-strip">
          <div><strong>{registry.stats.componentVariantsCount}</strong><span>Variantes Únicas</span></div>
          <div><strong>{registry.stats.totalComponentFiles}</strong><span>Archivos Framework</span></div>
          <div><strong>{registry.stats.animationPresetsCount}</strong><span>Demos Anime.js v4</span></div>
          <div><strong>{registry.stats.interfacesCount}</strong><span>Interfaces</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN 1: TODOS LOS APARTADOS DE COMPONENTES Y SUS VARIANTES -->
  <section class="home-section">
    <div class="home-section__head">
      <div>
        <span class="arch-eyebrow">01 // CATÁLOGO DE COMPONENTES POR APARTADO</span>
        <h2>Selecciona un Componente o Salta Directo a una Variante</h2>
      </div>
      <a href="/components" class="arch-btn">
        <span>Ver Índice Completo</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </div>

    <div class="arch-grid">
      {registry.componentCategories.map((cat) => (
        <article class="arch-cell cat-home-card">
          <div class="cat-home-card__top">
            <span class="mono-sm">{cat.code} // {cat.variants.length} VARIANTES</span>
            <Icon name={cat.icon} size={16} />
          </div>
          <h3>
            <a href={`/components/${cat.slug}`}>{cat.name}</a>
          </h3>
          <p>{cat.shortDesc}</p>

          <div class="variant-links-list">
            {cat.variants.slice(0, homeVariantLimit).map((v) => (
              <a href={`/components/${cat.slug}#${v.id}`} class="v-chip-link">
                <span>{v.name}</span>
                <Icon name="arrow-right" size={12} />
              </a>
            ))}
            {cat.variants.length > homeVariantLimit && (
              <a href={`/components/${cat.slug}`} class="v-chip-link v-chip-link--all">
                <span>Ver las {cat.variants.length} variantes</span>
                <Icon name="arrow-right" size={12} />
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- SECCIÓN 2: TODOS LOS CAPÍTULOS DE ANIME.JS v4 -->
  <section class="home-section">
    <div class="home-section__head">
      <div>
        <span class="arch-eyebrow">02 // ENCICLOPEDIA PRÁCTICA DE ANIME.JS v4</span>
        <h2>Documentación Interactiva y Animaciones Listas para Copiar</h2>
      </div>
      <a href="/animations" class="arch-btn">
        <span>Abrir Laboratorio General</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </div>

    <div class="arch-grid">
      {registry.animationCategories.map((anim) => (
        <article class="arch-cell cat-home-card">
          <div class="cat-home-card__top">
            <span class="mono-sm">{anim.code} // {anim.presets.length} DEMOS EN VIVO</span>
            <Icon name="activity" size={16} />
          </div>
          <h3>
            <a href={`/animations/${anim.slug}`}>{anim.name}</a>
          </h3>
          <p>{anim.desc}</p>

          <div class="variant-links-list">
            {anim.presets.slice(0, homeVariantLimit).map((p) => (
              <a href={`/animations/${anim.slug}#${p.id}`} class="v-chip-link">
                <span>{p.name}</span>
                <Icon name="arrow-right" size={12} />
              </a>
            ))}
            {anim.presets.length > homeVariantLimit && (
              <a href={`/animations/${anim.slug}`} class="v-chip-link v-chip-link--all">
                <span>Ver los {anim.presets.length} estudios</span>
                <Icon name="arrow-right" size={12} />
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<script>
  import { animate, stagger, svg } from 'animejs';

  function runHeroDemo() {
    const line = document.getElementById('hero-svg-line');
    if (line) {
      animate(svg.createDrawable(line), {
        draw: ['0 0', '0 1'],
        duration: 1400,
        ease: 'inOutQuad'
      });
    }
    const bars = document.querySelectorAll('#hero-stagger-bars .h-bar');
    if (bars.length) {
      animate(bars, {
        scaleY: [0.2, 1, 0.45, 0.9],
        opacity: [0.35, 1],
        duration: 950,
        delay: stagger(55, { from: 'center' }),
        ease: 'outBack'
      });
    }
  }

  runHeroDemo();
  document.getElementById('hero-anime-trigger')?.addEventListener('click', runHeroDemo);
</script>

<style>
  .hero-grid-shell {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    border: 1px solid var(--cxd-border-strong);
    background: var(--cxd-bg-surface);
    border-radius: var(--cxd-radius-lg);
    overflow: hidden;
    margin-bottom: 3rem;
  }

  @media (max-width: 980px) {
    .hero-grid-shell {
      grid-template-columns: 1fr;
    }
  }

  .hero-grid-shell__left {
    padding: 2.5rem;
    border-right: 1px solid var(--cxd-border);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.1rem;
  }

  .hero-main-title {
    font-size: clamp(1.85rem, 3.2vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .hero-main-lead {
    color: var(--cxd-text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .arch-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.05rem;
    background: var(--cxd-bg-elevated);
    color: var(--cxd-text-primary);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-sm);
    font-family: var(--cxd-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
  }

  .arch-btn--primary {
    background: var(--cxd-accent);
    color: var(--cxd-accent-fg, #000);
    border-color: var(--cxd-accent);
    font-weight: 600;
  }

  .hero-grid-shell__right {
    background: var(--cxd-bg-base);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-anime-widget {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .hero-anime-widget__bar {
    padding: 0.75rem 1.25rem;
    background: var(--cxd-bg-elevated);
    border-bottom: 1px solid var(--cxd-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mono-sm {
    font-family: var(--cxd-font-mono);
    font-size: 0.66rem;
    color: var(--cxd-text-muted);
    letter-spacing: 0.06em;
  }

  .mini-replay-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    background: var(--cxd-bg-surface);
    color: var(--cxd-text-primary);
    border: 1px solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-sm);
    font-family: var(--cxd-font-mono);
    font-size: 0.68rem;
    cursor: pointer;
  }

  .hero-anime-stage {
    flex: 1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .hero-circuit-svg {
    width: 100%;
    max-width: 320px;
    height: 80px;
    color: var(--cxd-accent);
  }

  .hero-stagger-bars {
    display: flex;
    gap: 6px;
    height: 44px;
    align-items: flex-end;
  }

  .h-bar {
    width: 10px;
    height: 100%;
    background: var(--cxd-accent);
    border-radius: 2px;
    transform-origin: bottom;
  }

  .hero-stats-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--cxd-border);
    background: var(--cxd-bg-surface);
  }

  .hero-stats-strip > div {
    padding: 0.85rem;
    text-align: center;
    border-right: 1px solid var(--cxd-border);
    display: flex;
    flex-direction: column;
  }

  .hero-stats-strip > div:last-child {
    border-right: none;
  }

  .hero-stats-strip strong {
    font-family: var(--cxd-font-mono);
    font-size: 1.25rem;
  }

  .hero-stats-strip span {
    font-size: 0.68rem;
    color: var(--cxd-text-muted);
  }

  .home-section {
    margin-bottom: 3.5rem;
  }

  .home-section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .home-section__head h2 {
    font-size: 1.4rem;
    font-weight: 700;
  }

  .cat-home-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--cxd-text-muted);
  }

  .cat-home-card h3 a {
    color: var(--cxd-text-primary);
    text-decoration: none;
    font-size: 1.08rem;
  }

  .cat-home-card h3 a:hover {
    text-decoration: underline;
  }

  .cat-home-card p {
    font-size: 0.82rem;
    color: var(--cxd-text-secondary);
    line-height: 1.5;
  }

  .variant-links-list {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 0.35rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--cxd-border);
  }

  .v-chip-link--all {
    color: var(--cxd-accent);
    border-color: color-mix(in srgb, var(--cxd-accent) 48%, var(--cxd-border));
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .hero-grid-shell__left { padding: 1.25rem; border-right: 0; border-bottom: 1px solid var(--cxd-border); }
    .hero-anime-widget__bar { align-items: flex-start; gap: .65rem; flex-direction: column; }
    .hero-stats-strip { grid-template-columns: repeat(2, 1fr); }
    .hero-stats-strip > div:nth-child(2) { border-right: none; }
    .hero-stats-strip > div:nth-child(-n+2) { border-bottom: 1px solid var(--cxd-border); }
    .arch-grid { grid-template-columns: 1fr; }
    .home-section__head { align-items: flex-start; }
  }

  .v-chip-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.38rem 0.6rem;
    background: var(--cxd-bg-base);
    border: 1px solid var(--cxd-border);
    border-radius: var(--cxd-radius-sm);
    color: var(--cxd-text-secondary);
    text-decoration: none;
    font-size: 0.74rem;
    transition: all 120ms ease;
  }

  .v-chip-link:hover {
    border-color: var(--cxd-accent);
    color: var(--cxd-text-primary);
    background: var(--cxd-bg-hover);
  }
</style>
