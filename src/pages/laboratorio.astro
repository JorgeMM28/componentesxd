---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Laboratorio visual | COMPONENTESXD" section="LABORATORIO">
  <div class="lab">
    <header class="lab-heading"><span>LABORATORIO CREATIVO / 01</span><h1>Estilo en movimiento.</h1><p>Explora tipografía, color y animación. Ajusta los controles y copia el CSS para usarlo en tu proyecto.</p></header>
    <div class="lab-layout">
      <section class="lab-controls" aria-label="Controles de diseño">
        <h2>Diseña tu escena</h2>
        <label>Texto <input id="lab-text" type="text" value="Las ideas cobran vida." maxlength="100" /></label>
        <label>Fuente <select id="lab-font"><option value="Inter, sans-serif">Inter · moderna</option><option value="Georgia, serif">Georgia · editorial</option><option value="'JetBrains Mono', monospace">JetBrains Mono · técnica</option><option value="Arial, sans-serif">Arial · universal</option></select></label>
        <label>Tamaño <input id="lab-size" type="range" min="24" max="100" value="64" /><output for="lab-size" id="lab-size-output">64 px</output></label>
        <label>Peso <select id="lab-weight"><option value="400">Regular</option><option value="600">Semibold</option><option value="800" selected>Extra bold</option></select></label>
        <label>Espaciado <input id="lab-spacing" type="range" min="-4" max="12" value="-2" /><output for="lab-spacing" id="lab-spacing-output">-2 px</output></label>
        <label>Tipo de degradado <select id="lab-gradient"><option value="linear">Lineal</option><option value="radial">Radial</option><option value="conic">Cónico</option></select></label>
        <label>Aplicar degradado a <select id="lab-target"><option value="text">Texto</option><option value="background">Fondo</option></select></label>
        <div class="lab-colors"><label>Color inicial <input id="lab-color-a" type="color" value="#ae8cff" /></label><label>Color final <input id="lab-color-b" type="color" value="#61e8ff" /></label></div>
        <label>Ángulo <input id="lab-angle" type="range" min="0" max="360" value="110" /><output for="lab-angle" id="lab-angle-output">110°</output></label>
        <label>Animación <select id="lab-motion"><option value="chars">Ola de caracteres</option><option value="words">Entrada por palabras</option><option value="lines">Revelado por líneas</option><option value="scramble">Texto cifrado</option><option value="none">Sin animación</option></select></label>
        <button type="button" id="lab-play">Reproducir animación ↗</button>
      </section>
      <div class="lab-result"><section class="lab-stage" id="lab-stage" aria-label="Vista previa"><span class="lab-stage-label">VISTA PREVIA EN VIVO</span><p id="lab-preview">Las ideas cobran vida.</p><span class="lab-stage-foot">TIPOGRAFÍA · COLOR · MOVIMIENTO</span></section>
        <section class="lab-code"><div><h2>CSS listo para copiar</h2><button type="button" id="lab-copy">Copiar CSS</button></div><pre><code id="lab-output"></code></pre><p id="lab-status" role="status"></p></section>
        <section class="lab-code"><div><h2>Animación Anime.js</h2><button type="button" id="lab-copy-motion">Copiar JS</button></div><pre><code id="lab-motion-output"></code></pre><p>Instala Anime.js 4.5 o superior y aplica este código a un elemento con la clase <code>texto</code>.</p><p id="lab-motion-status" role="status"></p></section>
      </div>
    </div>
    <section class="lab-modules" aria-label="Laboratorios especializados">
      <article class="lab-module" data-lab="surface"><header><span>LAB 02</span><h2>Gradientes y superficies</h2><p>Combina dos capas, borde y profundidad para una superficie lista para copiar.</p></header><div class="lab-module__grid"><div class="lab-controls"><label>Color base <input id="surface-base" type="color" value="#0f172a" /></label><label>Color de luz <input id="surface-light" type="color" value="#8b5cf6" /></label><label>Intensidad <input id="surface-strength" type="range" min="10" max="90" value="48" /></label><label>Radio <input id="surface-radius" type="range" min="0" max="32" value="16" /></label><label>Sombra <select id="surface-shadow"><option value="soft">Suave</option><option value="hard">Dura</option><option value="none">Sin sombra</option></select></label></div><div class="surface-preview" id="surface-preview"><span>SUPERFICIE / 02</span><strong>Capas que dan profundidad</strong></div></div><div class="lab-code"><div><h3>CSS de superficie</h3><button type="button" id="surface-copy">Copiar CSS</button></div><pre><code id="surface-output"></code></pre><p id="surface-status" role="status"></p></div></article>
      <article class="lab-module" data-lab="motion"><header><span>LAB 03</span><h2>Motion Studio</h2><p>Prueba ritmo, easing y secuencias sin mezclarlo con el laboratorio tipográfico.</p></header><div class="lab-module__grid"><div class="lab-controls"><label>Duración <input id="motion-duration" type="range" min="250" max="1800" step="50" value="700" /></label><label>Desfase <input id="motion-stagger" type="range" min="0" max="220" step="10" value="70" /></label><label>Easing <select id="motion-ease"><option value="outExpo">Out Expo</option><option value="inOutSine">In Out Sine</option><option value="outElastic(1,.5)">Out Elastic</option></select></label><label>Composición <select id="motion-mode"><option value="rise">Ascenso</option><option value="spread">Expansión</option><option value="rotate">Rotación</option></select></label><div class="lab-action-row"><button type="button" id="motion-play">Reproducir</button><button type="button" id="motion-pause">Pausar</button><button type="button" id="motion-reverse">Invertir</button><button type="button" id="motion-reset">Reiniciar</button></div></div><div class="motion-preview" id="motion-preview" aria-label="Escenario de movimiento"><i></i><i></i><i></i><i></i><i></i></div></div><div class="lab-code"><div><h3>JavaScript de movimiento</h3><button type="button" id="motion-copy">Copiar JS</button></div><pre><code id="motion-output"></code></pre><p id="motion-status" role="status">Escenario listo.</p></div></article>
      <article class="lab-module" data-lab="layout"><header><span>LAB 04</span><h2>Layout Composer</h2><p>Define una cuadrícula responsiva y observa la densidad antes de llevarla a tu interfaz.</p></header><div class="lab-module__grid"><div class="lab-controls"><label>Columnas <input id="layout-columns" type="range" min="1" max="4" value="3" /></label><label>Espacio <input id="layout-gap" type="range" min="4" max="40" value="16" /></label><label>Radio <input id="layout-radius" type="range" min="0" max="28" value="12" /></label><label>Densidad <select id="layout-density"><option value="compact">Compacta</option><option value="comfortable" selected>Equilibrada</option><option value="spacious">Amplia</option></select></label></div><div class="layout-preview" id="layout-preview" aria-label="Vista previa de cuadrícula"><i>01</i><i>02</i><i>03</i><i>04</i><i>05</i><i>06</i></div></div><div class="lab-code"><div><h3>CSS de layout</h3><button type="button" id="layout-copy">Copiar CSS</button></div><pre><code id="layout-output"></code></pre><p id="layout-status" role="status"></p></div></article>
      <article class="lab-module lab-module--compact" data-extra-lab="cards"><header><span>LAB 05</span><h2>Card Decision Deck</h2><p>Compara tres propuestas, selecciona una y observa un estado de tarjeta real.</p></header><div class="lab-deck" data-card-deck><button type="button" data-card="Básico"><b>Básico</b><small>Para prototipos</small></button><button type="button" data-card="Studio"><b>Studio</b><small>Para equipos</small></button><button type="button" data-card="Escala"><b>Escala</b><small>Para producción</small></button></div><p role="status" data-extra-status>Selecciona una tarjeta.</p></article>
      <article class="lab-module lab-module--compact" data-extra-lab="table"><header><span>LAB 06</span><h2>Table Filter Bench</h2><p>Filtra una tabla de datos sin recargar la interfaz.</p></header><label class="lab-inline-label">Buscar servicio <input type="search" data-table-search placeholder="API, Worker o Base de datos" /></label><div class="lab-table-wrap"><table data-filter-table><tbody><tr><td>API Gateway</td><td>Activo</td></tr><tr><td>Worker de correo</td><td>En pausa</td></tr><tr><td>Base de datos</td><td>Activo</td></tr></tbody></table></div><p role="status" data-extra-status>3 filas visibles.</p></article>
      <article class="lab-module lab-module--compact" data-extra-lab="grid"><header><span>LAB 07</span><h2>Bento Grid Resizer</h2><p>Ensaya una retícula con densidad variable.</p></header><label class="lab-inline-label">Columnas <input type="range" min="1" max="4" value="3" data-grid-range /></label><div class="lab-bento" data-bento><i>Analítica</i><i>Actividad</i><i>Equipo</i><i>Estado</i><i>Notas</i></div><p role="status" data-extra-status>3 columnas activas.</p></article>
      <article class="lab-module lab-module--compact" data-extra-lab="button"><header><span>LAB 08</span><h2>Async Button States</h2><p>Prueba reposo, carga y éxito con una única acción accesible.</p></header><button type="button" data-async-button>Publicar cambios</button><p role="status" data-extra-status>Listo para publicar.</p></article>
      <article class="lab-module lab-module--compact" data-extra-lab="form"><header><span>LAB 09</span><h2>Form Validation Meter</h2><p>Construye una contraseña y recibe una lectura inmediata.</p></header><label class="lab-inline-label">Contraseña <input type="password" data-password-input minlength="8" placeholder="Mínimo 8 caracteres" /></label><meter min="0" max="4" value="0" data-password-meter></meter><p role="status" data-extra-status>Introduce una contraseña.</p></article>
      <article class="lab-module lab-module--compact" data-extra-lab="toast"><header><span>LAB 10</span><h2>Toast Queue</h2><p>Agrega notificaciones y elimina cada una de forma independiente.</p></header><button type="button" data-toast-add>Crear notificación</button><div class="lab-toast-stack" data-toast-stack aria-live="polite"></div><p role="status" data-extra-status>La cola está vacía.</p></article>
      <article class="lab-module lab-module--compact" data-extra-lab="avatars"><header><span>LAB 11</span><h2>Avatar Presence</h2><p>Selecciona un integrante y cambia el contexto de presencia.</p></header><div class="lab-avatar-list" data-avatar-list><button type="button" data-person="Lucía · Diseño">LU</button><button type="button" data-person="Mateo · Frontend">MA</button><button type="button" data-person="Sara · Research">SA</button></div><p role="status" data-extra-status>3 personas disponibles.</p></article>
      <article class="lab-module lab-module--compact" data-extra-lab="chart"><header><span>LAB 12</span><h2>Metric Bars</h2><p>Modula una serie de datos para un dashboard compacto.</p></header><label class="lab-inline-label">Intensidad <input type="range" min="20" max="100" value="62" data-chart-range /></label><div class="lab-mini-chart" data-mini-chart><i></i><i></i><i></i><i></i><i></i></div><p role="status" data-extra-status>Serie al 62%.</p></article>
      <article class="lab-module lab-module--compact" data-extra-lab="dialog"><header><span>LAB 13</span><h2>Dialog Confirmation</h2><p>Verifica un flujo de confirmación sin bloquear el resto de la página.</p></header><button type="button" data-dialog-open>Abrir confirmación</button><dialog data-lab-dialog><form method="dialog"><p>¿Aplicar esta configuración al proyecto?</p><button value="cancel">Cancelar</button><button value="confirm">Confirmar</button></form></dialog><p role="status" data-extra-status>Sin acciones pendientes.</p></article>
      <article class="lab-module lab-module--compact" data-extra-lab="states"><header><span>LAB 14</span><h2>State Switcher</h2><p>Alterna entre estados de carga, vacío, error y éxito.</p></header><div class="lab-state-actions"><button type="button" data-state="Cargando">Cargando</button><button type="button" data-state="Vacío">Vacío</button><button type="button" data-state="Error">Error</button><button type="button" data-state="Éxito">Éxito</button></div><div class="lab-state-preview" data-state-preview>Estado inicial</div><p role="status" data-extra-status>Elige un estado.</p></article>
    </section>
  </div>
</Layout>
<script>
  import { animate, stagger, splitText, scrambleText } from 'animejs';
  const get = (id: string) => document.getElementById(id) as HTMLInputElement;
  const preview = get('lab-preview');
  const output = get('lab-output');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let split: ReturnType<typeof splitText> | null = null;
  let animation: { pause: () => unknown } | null = null;
  function reset() { animation?.pause(); animation = null; split?.revert(); split = null; }
  function update() {
    reset();
    const text = get('lab-text').value || 'Tu texto aquí';
    preview.textContent = text;
    const font = get('lab-font').value, size = get('lab-size').value, weight = get('lab-weight').value, spacing = get('lab-spacing').value, angle = get('lab-angle').value;
    const colorA = get('lab-color-a').value, colorB = get('lab-color-b').value;
    const kind = get('lab-gradient').value, target = get('lab-target').value;
    const background = kind === 'radial' ? `radial-gradient(circle, ${colorA}, ${colorB})` : kind === 'conic' ? `conic-gradient(from ${angle}deg, ${colorA}, ${colorB}, ${colorA})` : `linear-gradient(${angle}deg, ${colorA}, ${colorB})`;
    const stage = get('lab-stage');
    stage.style.backgroundImage = target === 'background' ? background : '';
    Object.assign(preview.style, {fontFamily: font, fontSize: `clamp(24px, 6vw, ${size}px)`, fontWeight: weight, letterSpacing: `${spacing}px`, backgroundImage: target === 'text' ? background : 'none', color: target === 'text' ? 'transparent' : '#111827'});
    get('lab-angle').disabled = kind === 'radial';
    get('lab-size-output').textContent = `${size} px`; get('lab-spacing-output').textContent = `${spacing} px`; get('lab-angle-output').textContent = kind === 'radial' ? 'No aplica' : `${angle}°`;
    const typeCss = `  font-family: ${font};\n  font-size: clamp(24px, 6vw, ${size}px);\n  font-weight: ${weight};\n  letter-spacing: ${spacing}px;`;
    output.textContent = target === 'text' ? `.texto {\n${typeCss}\n  background-image: ${background};\n  background-clip: text;\n  -webkit-background-clip: text;\n  color: transparent;\n}` : `.superficie {\n  background-image: ${background};\n}\n\n.texto {\n${typeCss}\n  color: #111827;\n}`;
    const mode = get('lab-motion').value;
    const motionCode = get('lab-motion-output');
    const safeText = JSON.stringify(text).replace(/</g, '\\u003c');
    if (mode === 'none') motionCode.textContent = '// Selecciona una animación para generar código.';
    else if (mode === 'scramble' && !/[<>&]/.test(text)) motionCode.textContent = `import { animate, scrambleText } from 'animejs';\nconst element = document.querySelector('.texto');\nelement.textContent = ${safeText};\nanimate(element, { innerHTML: scrambleText({ text: ${safeText} }), duration: 1200 });`;
    else {
      const splitMode = mode === 'scramble' ? 'chars' : mode;
      motionCode.textContent = `import { animate, stagger, splitText } from 'animejs';\nconst element = document.querySelector('.texto');\nelement.textContent = ${safeText};\nconst split = splitText(element, { lines: ${splitMode === 'lines'}, words: ${splitMode === 'words'}, chars: ${splitMode === 'chars'} });\nanimate(split.${splitMode}, { opacity: [0, 1], y: ['0.8em', '0em'], rotate: ${mode === 'chars' ? '[-8, 0]' : '[0, 0]'}, delay: stagger(${mode === 'chars' ? 28 : 100}), duration: 700, ease: 'outExpo' });\n// Usa split.revert() antes de reemplazar el texto o desmontar la vista.`;
    }
  }
  function play() {
    update();
    const mode = get('lab-motion').value;
    if (mode === 'none') return;
    if (reducedMotion.matches) {
      get('lab-motion-status').textContent = 'Movimiento reducido activo: se mantiene una vista estática.';
      return;
    }
    get('lab-motion-status').textContent = '';
    // scrambleText writes HTML: use the character reveal for markup-like user input.
    if (mode === 'scramble' && !/[<>&]/.test(preview.textContent || '')) { animation = animate(preview, { innerHTML: scrambleText({ text: preview.textContent || '' }), duration: 1200 }); return; }
    split = splitText(preview, { lines: mode === 'lines', words: mode === 'words', chars: mode === 'chars' || mode === 'scramble' });
    const targets = mode === 'lines' ? split.lines : mode === 'words' ? split.words : split.chars;
    animation = animate(targets, { opacity: [0, 1], y: ['0.8em', '0em'], rotate: mode === 'chars' ? [-8, 0] : [0, 0], delay: stagger(mode === 'chars' ? 28 : 100), duration: 700, ease: 'outExpo' });
  }
  document.querySelectorAll('.lab-controls input, .lab-controls select').forEach(el => el.addEventListener('input', update));
  get('lab-play').addEventListener('click', play);
  get('lab-copy-motion').addEventListener('click', async () => { try { await navigator.clipboard.writeText(get('lab-motion-output').textContent || ''); get('lab-motion-status').textContent = 'JS copiado.'; } catch { get('lab-motion-status').textContent = 'No se pudo copiar. Selecciona el código manualmente.'; } });
  get('lab-copy').addEventListener('click', async () => { try { await navigator.clipboard.writeText(output.textContent || ''); get('lab-status').textContent = 'CSS copiado.'; } catch { get('lab-status').textContent = 'No se pudo copiar. Selecciona el código manualmente.'; } });

  const copyLabCode = async (source: string, status: string) => { try { await navigator.clipboard.writeText(get(source).textContent || ''); get(status).textContent = 'Código copiado.'; } catch { get(status).textContent = 'No se pudo copiar; selecciona el código manualmente.'; } };
  function updateSurface() {
    const base = get('surface-base').value, light = get('surface-light').value, strength = get('surface-strength').value, radius = get('surface-radius').value, shadow = get('surface-shadow').value;
    const preview = get('surface-preview'); const shadowCss = shadow === 'none' ? 'none' : shadow === 'hard' ? `8px 8px 0 ${light}` : `0 24px 60px color-mix(in srgb, ${light} 35%, transparent)`;
    Object.assign(preview.style, { background: `radial-gradient(circle at 78% 18%, color-mix(in srgb, ${light} ${strength}%, transparent), transparent 48%), ${base}`, borderRadius: `${radius}px`, boxShadow: shadowCss, borderColor: light });
    get('surface-output').textContent = `.surface {\n  background: radial-gradient(circle at 78% 18%, color-mix(in srgb, ${light} ${strength}%, transparent), transparent 48%), ${base};\n  border: 1px solid ${light};\n  border-radius: ${radius}px;\n  box-shadow: ${shadowCss};\n}`;
  }
  let motionStudio: ReturnType<typeof animate> | undefined;
  function updateMotionCode() {
    const duration = get('motion-duration').value, delay = get('motion-stagger').value, ease = get('motion-ease').value, mode = get('motion-mode').value;
    const props = mode === 'spread' ? `scale: [0.4, 1], x: [-32, 0]` : mode === 'rotate' ? `rotate: [-90, 0], scale: [0.6, 1]` : `y: [28, 0], opacity: [0, 1]`;
    get('motion-output').textContent = `import { animate, stagger } from 'animejs';\n\nanimate('.motion-item', {\n  ${props},\n  duration: ${duration},\n  delay: stagger(${delay}),\n  ease: '${ease}'\n});`;
  }
  function playMotion(reverse = false) {
    const items = get('motion-preview').querySelectorAll('i');
    const duration = Number(get('motion-duration').value), delay = Number(get('motion-stagger').value), ease = get('motion-ease').value, mode = get('motion-mode').value;
    if (reducedMotion.matches) { get('motion-status').textContent = 'Movimiento reducido activo: composición estática.'; return; }
    motionStudio?.pause();
    const properties = mode === 'spread' ? { scale: reverse ? [1, .4] : [.4, 1], x: reverse ? [0, -32] : [-32, 0] } : mode === 'rotate' ? { rotate: reverse ? [0, -90] : [-90, 0], scale: reverse ? [1, .6] : [.6, 1] } : { y: reverse ? [0, 28] : [28, 0], opacity: reverse ? [1, 0] : [0, 1] };
    motionStudio = animate(items, { ...properties, duration, delay: stagger(delay), ease });
    get('motion-status').textContent = reverse ? 'Secuencia invertida.' : 'Reproduciendo secuencia.';
  }
  function resetMotion() { motionStudio?.pause(); get('motion-preview').querySelectorAll<HTMLElement>('i').forEach(item => item.style.cssText = ''); get('motion-status').textContent = 'Escenario reiniciado.'; }
  function updateLayout() {
    const columns = get('layout-columns').value, gap = get('layout-gap').value, radius = get('layout-radius').value, density = get('layout-density').value;
    const padding = density === 'compact' ? 8 : density === 'spacious' ? 24 : 16; const preview = get('layout-preview');
    Object.assign(preview.style, { gridTemplateColumns: `repeat(${columns}, minmax(0, 1fr))`, gap: `${gap}px` });
    preview.querySelectorAll<HTMLElement>('i').forEach(card => { card.style.padding = `${padding}px`; card.style.borderRadius = `${radius}px`; });
    get('layout-output').textContent = `.grid {\n  display: grid;\n  grid-template-columns: repeat(${columns}, minmax(0, 1fr));\n  gap: ${gap}px;\n}\n.grid > * { padding: ${padding}px; border-radius: ${radius}px; }\n@media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }`;
  }
  document.querySelectorAll('#surface-base,#surface-light,#surface-strength,#surface-radius,#surface-shadow').forEach(control => control.addEventListener('input', updateSurface));
  document.querySelectorAll('#motion-duration,#motion-stagger,#motion-ease,#motion-mode').forEach(control => control.addEventListener('input', updateMotionCode));
  document.querySelectorAll('#layout-columns,#layout-gap,#layout-radius,#layout-density').forEach(control => control.addEventListener('input', updateLayout));
  get('surface-copy').addEventListener('click', () => copyLabCode('surface-output', 'surface-status'));
  get('motion-copy').addEventListener('click', () => copyLabCode('motion-output', 'motion-status'));
  get('layout-copy').addEventListener('click', () => copyLabCode('layout-output', 'layout-status'));
  get('motion-play').addEventListener('click', () => playMotion()); get('motion-pause').addEventListener('click', () => { motionStudio?.pause(); get('motion-status').textContent = 'Secuencia pausada.'; }); get('motion-reverse').addEventListener('click', () => playMotion(true)); get('motion-reset').addEventListener('click', resetMotion);

  document.querySelectorAll<HTMLElement>('[data-extra-lab]').forEach(lab => {
    const status = lab.querySelector<HTMLElement>('[data-extra-status]');
    const setStatus = (message: string) => { if (status) status.textContent = message; };
    const cards = lab.querySelector<HTMLElement>('[data-card-deck]');
    cards?.addEventListener('click', event => { const card = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-card]'); if (!card) return; cards.querySelectorAll('button').forEach(item => item.classList.toggle('is-active', item === card)); setStatus(`Plan ${card.dataset.card} seleccionado.`); });
    const search = lab.querySelector<HTMLInputElement>('[data-table-search]');
    const rows = Array.from(lab.querySelectorAll<HTMLTableRowElement>('[data-filter-table] tr'));
    search?.addEventListener('input', () => { const term = search.value.toLowerCase().trim(); const visible = rows.filter(row => { const match = row.textContent?.toLowerCase().includes(term); row.hidden = !match; return match; }).length; setStatus(`${visible} fila${visible === 1 ? '' : 's'} visible${visible === 1 ? '' : 's'}.`); });
    const gridRange = lab.querySelector<HTMLInputElement>('[data-grid-range]'); const bento = lab.querySelector<HTMLElement>('[data-bento]');
    gridRange?.addEventListener('input', () => { if (bento) bento.style.gridTemplateColumns = `repeat(${gridRange.value}, minmax(0, 1fr))`; setStatus(`${gridRange.value} columnas activas.`); });
    const asyncButton = lab.querySelector<HTMLButtonElement>('[data-async-button]');
    asyncButton?.addEventListener('click', () => { asyncButton.disabled = true; asyncButton.textContent = 'Publicando…'; setStatus('Cambios en proceso.'); window.setTimeout(() => { asyncButton.disabled = false; asyncButton.textContent = 'Publicado ✓'; setStatus('Cambios publicados correctamente.'); }, 700); });
    const password = lab.querySelector<HTMLInputElement>('[data-password-input]'); const meter = lab.querySelector<HTMLMeterElement>('[data-password-meter]');
    password?.addEventListener('input', () => { const value = password.value; const score = Number(value.length >= 8) + Number(/[A-Z]/.test(value)) + Number(/[0-9]/.test(value)) + Number(/[^A-Za-z0-9]/.test(value)); if (meter) meter.value = score; setStatus(score < 2 ? 'Contraseña débil.' : score < 4 ? 'Contraseña aceptable.' : 'Contraseña sólida.'); });
    const toastStack = lab.querySelector<HTMLElement>('[data-toast-stack]'); let toastCount = 0;
    lab.querySelector('[data-toast-add]')?.addEventListener('click', () => { if (!toastStack) return; toastCount++; const toast = document.createElement('button'); toast.type = 'button'; toast.textContent = `Notificación ${toastCount} · cerrar`; toast.addEventListener('click', () => { toast.remove(); setStatus(`${toastStack.childElementCount} notificaciones activas.`); }); toastStack.append(toast); setStatus(`${toastStack.childElementCount} notificaciones activas.`); });
    const avatars = lab.querySelector<HTMLElement>('[data-avatar-list]');
    avatars?.addEventListener('click', event => { const person = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-person]'); if (!person) return; avatars.querySelectorAll('button').forEach(item => item.classList.toggle('is-active', item === person)); setStatus(`${person.dataset.person} está en línea.`); });
    const chartRange = lab.querySelector<HTMLInputElement>('[data-chart-range]'); const chartBars = lab.querySelectorAll<HTMLElement>('[data-mini-chart] i');
    chartRange?.addEventListener('input', () => { const base = Number(chartRange.value); chartBars.forEach((bar, index) => bar.style.height = `${Math.max(16, Math.min(100, base + (index - 2) * 11))}%`); setStatus(`Serie al ${base}%.`); });
    const dialog = lab.querySelector<HTMLDialogElement>('[data-lab-dialog]');
    lab.querySelector('[data-dialog-open]')?.addEventListener('click', () => dialog?.showModal());
    dialog?.addEventListener('close', () => setStatus(dialog.returnValue === 'confirm' ? 'Configuración aplicada.' : 'Confirmación cancelada.'));
    const statePreview = lab.querySelector<HTMLElement>('[data-state-preview]');
    lab.querySelectorAll<HTMLButtonElement>('[data-state]').forEach(button => button.addEventListener('click', () => { const state = button.dataset.state || ''; if (statePreview) { statePreview.textContent = state; statePreview.dataset.state = state.toLowerCase(); } setStatus(`Estado: ${state}.`); }));
  });
  updateSurface(); updateMotionCode(); updateLayout();
  update();
</script>
