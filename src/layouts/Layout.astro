---
import '../../styles/tokens.css';
import '../../components/tables/css-scss/table.css';
import '../../components/buttons/css-scss/buttons.css';
import '../../components/cards/css-scss/cards.css';
import '../../components/modals/css-scss/modals.css';
import '../../components/forms/css-scss/forms.css';
import '../../components/alerts-toasts/css-scss/toasts.css';
import Icon from '../components/Icon.astro';
import registry from '../data/vaultRegistry.json';

interface Props {
  title?: string;
  section?: string;
}

const {
  title = 'COMPONENTESXD // Bóveda Multi-Framework & Anime.js v4',
  section = 'SYSTEM'
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="es" data-theme="geist-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('cxd-interface-theme');
          if (saved) {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <!-- ======================================================================
         TOP NAVBAR CON MENÚ EN CASCADA MULTI-NIVEL (ESTILO MICROSOFT) + ANIME.JS
         ====================================================================== -->
    <header class="ms-navbar" id="top-navbar">
      <div class="ms-navbar__container">
        <!-- Brand -->
        <a href="/" class="ms-brand">
          <span class="ms-brand__logo">
            <Icon name="cpu" size={16} />
          </span>
          <div class="ms-brand__text">
            <span class="ms-brand__title">COMPONENTESXD</span>
            <span class="ms-brand__meta">{registry.stats.totalComponentFiles} ARCHIVOS · ANIME.JS v4</span>
          </div>
        </a>

        <!-- Navegación Principal con Disparadores de Cascada -->
        <nav class="ms-nav-links" aria-label="Navegación principal">
          <a href="/" class={`ms-nav-item ${pathname === '/' ? 'is-current' : ''}`}>
            <span>Inicio</span>
          </a>

          <!-- 1. MENÚ EN CASCADA: COMPONENTES -> CATEGORÍA -> VARIANTES -->
          <div class="ms-cascade-wrapper" data-cascade-root="components">
            <button
              type="button"
              class={`ms-nav-trigger ${pathname.startsWith('/components') ? 'is-current' : ''}`}
              data-cascade-btn="components"
              aria-expanded="false"
            >
              <Icon name="grid" size={14} />
              <span>Componentes ({registry.stats.componentVariantsCount})</span>
              <Icon name="chevron-down" size={13} class="ms-chevron" />
            </button>

            <div class="ms-mega-dropdown" id="mega-components" hidden>
              <div class="ms-mega-grid">
                <!-- Columna 1: Lista de Categorías de Componentes -->
                <div class="ms-mega-col-primary">
                  <div class="ms-mega-col-title">
                    <span>01 // SELECCIONA UN COMPONENTE</span>
                    <a href="/components" class="ms-mega-all-link">Ver índice</a>
                  </div>
                  <div class="ms-category-list">
                    {registry.componentCategories.map((cat, idx) => (
                      <a
                        href={`/components/${cat.slug}`}
                        class={`ms-cat-trigger ${idx === 0 ? 'is-active' : ''}`}
                        data-cascade-cat={`comp-cat-${cat.slug}`}
                      >
                        <Icon name={cat.icon} size={15} />
                        <div class="ms-cat-trigger__text">
                          <strong>{cat.name}</strong>
                          <small>{cat.variants.length} variantes en la página</small>
                        </div>
                        <Icon name="arrow-right" size={13} class="ms-cat-arrow" />
                      </a>
                    ))}
                  </div>
                </div>

                <!-- Columna 2: Variantes Desplegadas de la Categoría Activa -->
                <div class="ms-mega-col-secondary">
                  {registry.componentCategories.map((cat, idx) => (
                    <div
                      class={`ms-subpanel ${idx === 0 ? 'is-active' : ''}`}
                      id={`comp-cat-${cat.slug}`}
                      data-subpanel
                    >
                      <div class="ms-subpanel__head">
                        <div>
                          <span class="ms-subpanel__eyebrow">{cat.code} // {cat.variants.length} VARIANTES DISPONIBLES</span>
                          <h3>{cat.name}</h3>
                          <p>{cat.shortDesc}</p>
                        </div>
                        <a href={`/components/${cat.slug}`} class="ms-open-page-btn">
                          <span>Abrir Página Completa</span>
                          <Icon name="arrow-right" size={13} />
                        </a>
                      </div>

                      <div class="ms-variants-grid">
                        {cat.variants.map((v) => (
                          <a
                            href={`/components/${cat.slug}#${v.id}`}
                            class="ms-variant-link"
                            data-cascade-leaf
                          >
                            <span class="ms-variant-badge">{v.badge}</span>
                            <strong>{v.name}</strong>
                            <small>{v.desc}</small>
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- 2. MENÚ EN CASCADA: ANIMACIONES ANIME.JS v4 -> SECCIÓN -> PRESETS -->
          <div class="ms-cascade-wrapper" data-cascade-root="animations">
            <button
              type="button"
              class={`ms-nav-trigger ${pathname.startsWith('/animations') ? 'is-current' : ''}`}
              data-cascade-btn="animations"
              aria-expanded="false"
            >
              <Icon name="activity" size={14} />
              <span>Animaciones Anime.js ({registry.stats.animationPresetsCount})</span>
              <Icon name="chevron-down" size={13} class="ms-chevron" />
            </button>

            <div class="ms-mega-dropdown" id="mega-animations" hidden>
              <div class="ms-mega-grid">
                <!-- Columna 1: Capítulos Oficiales de Anime.js v4 -->
                <div class="ms-mega-col-primary">
                  <div class="ms-mega-col-title">
                    <span>01 // DOCUMENTACIÓN & CATEGORÍAS ANIME.JS v4</span>
                    <a href="/animations" class="ms-mega-all-link">Ver todas</a>
                  </div>
                  <div class="ms-category-list">
                    {registry.animationCategories.map((anim, idx) => (
                      <a
                        href={`/animations/${anim.slug}`}
                        class={`ms-cat-trigger ${idx === 0 ? 'is-active' : ''}`}
                        data-cascade-cat={`anim-cat-${anim.slug}`}
                      >
                        <Icon name="activity" size={15} />
                        <div class="ms-cat-trigger__text">
                          <strong>{anim.name}</strong>
                          <small>{anim.presets.length} animaciones en vivo</small>
                        </div>
                        <Icon name="arrow-right" size={13} class="ms-cat-arrow" />
                      </a>
                    ))}
                  </div>
                </div>

                <!-- Columna 2: Presets de la Categoría Seleccionada -->
                <div class="ms-mega-col-secondary">
                  {registry.animationCategories.map((anim, idx) => (
                    <div
                      class={`ms-subpanel ${idx === 0 ? 'is-active' : ''}`}
                      id={`anim-cat-${anim.slug}`}
                      data-subpanel
                    >
                      <div class="ms-subpanel__head">
                        <div>
                          <span class="ms-subpanel__eyebrow">{anim.code} // ANIME.JS v4 DOCUMENTATION</span>
                          <h3>{anim.name}</h3>
                          <p>{anim.desc}</p>
                        </div>
                        <a href={`/animations/${anim.slug}`} class="ms-open-page-btn">
                          <span>Abrir Apartado de Animación</span>
                          <Icon name="arrow-right" size={13} />
                        </a>
                      </div>

                      <div class="ms-variants-grid">
                        {anim.presets.map((p) => (
                          <a
                            href={`/animations/${anim.slug}#${p.id}`}
                            class="ms-variant-link"
                            data-cascade-leaf
                          >
                            <span class="ms-variant-badge">{p.ease} · {p.duration}ms</span>
                            <strong>{p.name}</strong>
                            <small>{p.desc}</small>
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- 3. MENÚ EN CASCADA: 12 INTERFACES DE DISEÑO -->
          <div class="ms-cascade-wrapper" data-cascade-root="interfaces">
            <button
              type="button"
              class={`ms-nav-trigger ${pathname.startsWith('/interfaces') ? 'is-current' : ''}`}
              data-cascade-btn="interfaces"
              aria-expanded="false"
            >
              <Icon name="palette" size={14} />
              <span>Interfaces ({registry.interfaces.length})</span>
              <Icon name="chevron-down" size={13} class="ms-chevron" />
            </button>

            <div class="ms-mega-dropdown ms-mega-dropdown--compact" id="mega-interfaces" hidden>
              <div class="ms-interfaces-panel">
                <div class="ms-subpanel__head">
                  <div>
                    <span class="ms-subpanel__eyebrow">CAMBIO INSTANTÁNEO DE TEMA E INTERFAZ</span>
                    <h3>Selecciona cualquiera de las 12 Interfaces Arquitectónicas</h3>
                  </div>
                  <a href="/interfaces" class="ms-open-page-btn">
                    <span>Abrir Estudio Comparativo</span>
                    <Icon name="arrow-right" size={13} />
                  </a>
                </div>
                <div class="ms-iface-grid">
                  {registry.interfaces.map((iface) => (
                    <button
                      type="button"
                      class="ms-iface-option"
                      data-pick-interface={iface.id}
                    >
                      <span class="ms-iface-dot" style={`background:${iface.accent}; border-color:${iface.bg}`}></span>
                      <div class="ms-iface-meta">
                        <strong>{iface.code} · {iface.name}</strong>
                        <small>{iface.origin} · Modo {iface.mode}</small>
                      </div>
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <a href="/components/special-hybrids" class={`ms-nav-item ${pathname.startsWith('/components/special-hybrids') ? 'is-current' : ''}`}>
            <Icon name="sparkles" size={14} />
            <span>Especiales + Anime.js (30)</span>
          </a>

          <a href="/guides" class={`ms-nav-item ${pathname.startsWith('/guides') ? 'is-current' : ''}`}>
            <Icon name="book" size={14} />
            <span>Guías & Agent Skill</span>
          </a>
        </nav>

        <!-- Barra Derecha: Indicador de Ruta & Selector Rápido de Interfaz -->
        <div class="ms-navbar__right">
          <span class="route-pill">
            <span>{section}</span>
          </span>
        </div>
      </div>
    </header>

    <!-- CONTENIDO DE LA PÁGINA COMPLETA -->
    <main class="page-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__left">
          <strong>COMPONENTESXD</strong>
          <span>·</span>
          <span>{registry.stats.totalComponentFiles} Archivos de Componentes</span>
          <span>·</span>
          <span>{registry.stats.totalAnimationFiles} Módulos Anime.js v4</span>
          <span>·</span>
          <span>{registry.stats.interfacesCount} Interfaces</span>
        </div>
        <div class="site-footer__links">
          <a href="/components">Componentes</a>
          <a href="/animations">Anime.js v4</a>
          <a href="/interfaces">Interfaces</a>
          <a href="/guides">Guías & Skill</a>
        </div>
      </div>
    </footer>

    <script>
      import { animate, stagger } from 'animejs';

      // Controlador de Menú en Cascada Multi-Nivel (Estilo Microsoft) con Anime.js v4
      const wrappers = document.querySelectorAll<HTMLElement>('[data-cascade-root]');
      let openRoot: string | null = null;

      function closeAllMenus() {
        wrappers.forEach((w) => {
          const btn = w.querySelector<HTMLButtonElement>('[data-cascade-btn]');
          const panel = w.querySelector<HTMLElement>('.ms-mega-dropdown');
          btn?.setAttribute('aria-expanded', 'false');
          btn?.classList.remove('is-open');
          if (panel) panel.hidden = true;
        });
        openRoot = null;
      }

      function openMenu(rootName: string) {
        wrappers.forEach((w) => {
          const isTarget = w.dataset.cascadeRoot === rootName;
          const btn = w.querySelector<HTMLButtonElement>('[data-cascade-btn]');
          const panel = w.querySelector<HTMLElement>('.ms-mega-dropdown');
          if (!panel || !btn) return;

          if (isTarget) {
            panel.hidden = false;
            btn.setAttribute('aria-expanded', 'true');
            btn.classList.add('is-open');
            animate(panel, {
              opacity: [0, 1],
              y: [-8, 0],
              duration: 220,
              ease: 'outExpo'
            });
            const activeLeaves = panel.querySelectorAll('.ms-subpanel.is-active [data-cascade-leaf]');
            if (activeLeaves.length) {
              animate(activeLeaves, {
                opacity: [0, 1],
                x: [-8, 0],
                duration: 240,
                delay: stagger(18),
                ease: 'outQuad'
              });
            }
          } else {
            panel.hidden = true;
            btn.setAttribute('aria-expanded', 'false');
            btn.classList.remove('is-open');
          }
        });
        openRoot = rootName;
      }

      wrappers.forEach((w) => {
        const rootName = w.dataset.cascadeRoot!;
        const btn = w.querySelector<HTMLButtonElement>('[data-cascade-btn]');
        const catTriggers = w.querySelectorAll<HTMLElement>('[data-cascade-cat]');
        const subpanels = w.querySelectorAll<HTMLElement>('[data-subpanel]');

        btn?.addEventListener('click', (e) => {
          e.stopPropagation();
          if (openRoot === rootName) {
            closeAllMenus();
          } else {
            openMenu(rootName);
          }
        });

        // Al pasar el cursor por una categoría en Columna 1, se despliegan sus variantes en Columna 2
        catTriggers.forEach((trig) => {
          const activateSubpanel = () => {
            const targetId = trig.dataset.cascadeCat;
            catTriggers.forEach((t) => t.classList.toggle('is-active', t === trig));
            subpanels.forEach((sp) => {
              const match = sp.id === targetId;
              sp.classList.toggle('is-active', match);
              if (match) {
                const leaves = sp.querySelectorAll('[data-cascade-leaf]');
                animate(leaves, {
                  opacity: [0, 1],
                  x: [-6, 0],
                  duration: 200,
                  delay: stagger(15),
                  ease: 'outQuad'
                });
              }
            });
          };

          trig.addEventListener('mouseenter', activateSubpanel);
          trig.addEventListener('focus', activateSubpanel);
        });
      });

      // Cerrar menú al hacer clic fuera o en un enlace hoja
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('[data-cascade-leaf]')) {
          closeAllMenus();
          return;
        }
        if (!target.closest('[data-cascade-root]')) {
          closeAllMenus();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAllMenus();
      });

      // Selector de las 12 Interfaces
      function applyInterfaceTheme(themeId: string) {
        document.documentElement.setAttribute('data-theme', themeId);
        try {
          localStorage.setItem('cxd-interface-theme', themeId);
        } catch (err) {}
        document.querySelectorAll<HTMLElement>('[data-pick-interface]').forEach((btn) => {
          btn.classList.toggle('is-active', btn.dataset.pickInterface === themeId);
        });
      }

      const initialTheme = document.documentElement.getAttribute('data-theme') || 'geist-dark';
      applyInterfaceTheme(initialTheme);

      document.querySelectorAll<HTMLButtonElement>('[data-pick-interface]').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.dataset.pickInterface) {
            applyInterfaceTheme(btn.dataset.pickInterface);
            closeAllMenus();
          }
        });
      });

      window.addEventListener('cxd:request-theme', (e: any) => {
        if (e.detail?.theme) applyInterfaceTheme(e.detail.theme);
      });
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  [hidden] {
    display: none !important;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
    background-color: var(--cxd-bg-base);
    color: var(--cxd-text-primary);
    font-family: var(--cxd-font-sans);
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    background-color: var(--cxd-bg-base);
    color: var(--cxd-text-primary);
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* ==========================================================================
     MICROSOFT-STYLE TOP NAVBAR & MULTI-LEVEL CASCADING MEGA-MENU
     ========================================================================== */
  .ms-navbar {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--cxd-bg-glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: var(--cxd-border-width, 1px) solid var(--cxd-border);
  }

  .ms-navbar__container {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .ms-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--cxd-text-primary);
    flex-shrink: 0;
  }

  .ms-brand__logo {
    width: 32px;
    height: 32px;
    border: 1px solid var(--cxd-border-strong);
    background: var(--cxd-bg-elevated);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--cxd-radius-sm);
    color: var(--cxd-accent);
  }

  .ms-brand__text {
    display: flex;
    flex-direction: column;
  }

  .ms-brand__title {
    font-family: var(--cxd-font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .ms-brand__meta {
    font-family: var(--cxd-font-mono);
    font-size: 0.62rem;
    color: var(--cxd-text-muted);
  }

  .ms-nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .ms-nav-item,
  .ms-nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 38px;
    padding: 0 0.85rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--cxd-radius-sm);
    color: var(--cxd-text-secondary);
    font-family: var(--cxd-font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 140ms ease;
  }

  .ms-nav-item:hover,
  .ms-nav-trigger:hover {
    color: var(--cxd-text-primary);
    background: var(--cxd-bg-hover);
  }

  .ms-nav-item.is-current,
  .ms-nav-trigger.is-current,
  .ms-nav-trigger.is-open {
    color: var(--cxd-text-primary);
    background: var(--cxd-bg-active);
    border-color: var(--cxd-border-strong);
    font-weight: 600;
  }

  .ms-chevron {
    transition: transform 180ms ease;
  }

  .ms-nav-trigger.is-open .ms-chevron {
    transform: rotate(180deg);
  }

  /* Mega Dropdown Container — Abre del lado izquierdo hacia la derecha dentro del contenedor */
  .ms-mega-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 1.5rem;
    right: 1.5rem;
    width: auto;
    max-width: calc(100vw - 3rem);
    background: var(--cxd-bg-surface);
    border: var(--cxd-border-width, 1px) solid var(--cxd-border-strong);
    border-radius: var(--cxd-radius-md);
    box-shadow: var(--cxd-shadow-lg);
    z-index: 300;
    overflow: hidden;
    transform-origin: top left;
  }

  .ms-mega-dropdown--compact {
    right: auto;
    width: min(920px, calc(100vw - 3rem));
  }

  .ms-mega-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    min-height: 440px;
    max-height: 78vh;
  }

  @media (max-width: 900px) {
    .ms-mega-grid {
      grid-template-columns: 1fr;
      overflow-y: auto;
    }
  }

  .ms-mega-col-primary {
    background: var(--cxd-bg-elevated);
    border-right: 1px solid var(--cxd-border);
    padding: 1rem 0.75rem;
    overflow-y: auto;
  }

  .ms-mega-col-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.6rem 0.65rem;
    font-family: var(--cxd-font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--cxd-text-muted);
    letter-spacing: 0.06em;
  }

  .ms-mega-all-link {
    color: var(--cxd-text-primary);
    text-decoration: none;
  }

  .ms-category-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ms-cat-trigger {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--cxd-radius-sm);
    color: var(--cxd-text-secondary);
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 120ms ease;
  }

  .ms-cat-trigger:hover,
  .ms-cat-trigger.is-active {
    background: var(--cxd-bg-surface);
    color: var(--cxd-text-primary);
    border-color: var(--cxd-border-strong);
  }

  .ms-cat-trigger__text {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .ms-cat-trigger__text strong {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .ms-cat-trigger__text small {
    font-size: 0.68rem;
    color: var(--cxd-text-muted);
    font-family: var(--cxd-font-mono);
  }

  .ms-cat-arrow {
    opacity: 0.4;
  }

  .ms-cat-trigger.is-active .ms-cat-arrow {
    opacity: 1;
    color: var(--cxd-accent);
  }

  /* Secondary Column (Variants Cascade) */
  .ms-mega-col-secondary {
    padding: 1.25rem 1.5rem;
    overflow-y: auto;
    background: var(--cxd-bg-surface);
  }

  .ms-subpanel {
    display: none;
  }

  .ms-subpanel.is-active {
    display: block;
  }

  .ms-subpanel__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--cxd-border);
  }

